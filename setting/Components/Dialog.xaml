<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Citadel.Setting.Components">
    <Style x:Key="SettingDialogStyle" TargetType="{x:Type local:SettingDialog}">
        <Setter Property="Background" Value="{DynamicResource Bg}" />
        <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        <Setter Property="ResizeMode" Value="NoResize" />
        <Setter Property="ShowInTaskbar" Value="False" />
        <Setter Property="SizeToContent" Value="Height" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:SettingDialog}">
                    <AdornerDecorator>
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource Border}"
                            BorderThickness="1"
                            Padding="{DynamicResource SettingCardPadding}">
                            <ContentPresenter />
                        </Border>
                    </AdornerDecorator>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
