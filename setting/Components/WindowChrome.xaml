<UserControl
    x:Class="Citadel.Setting.Components.SettingWindowChrome"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Citadel.Setting.Components"
    Height="36"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Top"
    IsHitTestVisible="True"
    Opacity="1">
    <Border
        x:Name="ChromeSurface"
        Background="{DynamicResource BgRail}"
        BorderBrush="{DynamicResource Border}"
        BorderThickness="0,0,0,1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                x:Name="TitleText"
                Grid.Column="0"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                FontSize="{DynamicResource SettingBodyFontSize}"
                Foreground="{DynamicResource Fg}"
                IsHitTestVisible="False"
                Text="{Binding Title, RelativeSource={RelativeSource AncestorType={x:Type local:SettingWindowChrome}}}"
                TextTrimming="CharacterEllipsis" />

            <StackPanel
                Grid.Column="1"
                Margin="0,0,4,0"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <local:SettingButton
                    x:Name="MinimizeButton"
                    Width="28"
                    Height="28"
                    Padding="0"
                    ToolTip="Minimise">
                    <Path
                        Width="10"
                        Height="1"
                        Data="M 0 0.5 L 10 0.5"
                        Stroke="{DynamicResource Fg}"
                        StrokeThickness="1.5" />
                </local:SettingButton>
                <local:SettingButton
                    x:Name="MaxRestoreButton"
                    Width="28"
                    Height="28"
                    Padding="0"
                    ToolTip="Maximise">
                    <Path
                        Width="10"
                        Height="10"
                        Data="M 0 0 L 10 0 L 10 10 L 0 10 Z"
                        Stroke="{DynamicResource Fg}"
                        StrokeThickness="1.5" />
                </local:SettingButton>
                <local:SettingButton
                    x:Name="CloseButton"
                    Width="28"
                    Height="28"
                    Padding="0"
                    ToolTip="Close">
                    <Path
                        Width="10"
                        Height="10"
                        Data="M 0 0 L 10 10 M 10 0 L 0 10"
                        Stroke="{DynamicResource Fg}"
                        StrokeThickness="1.5" />
                </local:SettingButton>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
