<ToggleButton
    x:Class="Citadel.Setting.Components.SettingToggle"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Citadel.Setting.Components"
    FontSize="{DynamicResource SettingBodyFontSize}"
    Foreground="{DynamicResource Fg}"
    IsThreeState="False">
    <ToggleButton.Template>
        <ControlTemplate TargetType="{x:Type local:SettingToggle}">
            <StackPanel Orientation="Horizontal">
                <Border
                    x:Name="Track"
                    Width="34"
                    Height="18"
                    Background="{DynamicResource Hover}"
                    CornerRadius="9">
                    <Ellipse
                        x:Name="Knob"
                        Width="12"
                        Height="12"
                        Margin="3,0,0,0"
                        Fill="{DynamicResource Dim}"
                        HorizontalAlignment="Left" />
                </Border>
                <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Track" Property="Background" Value="{DynamicResource Selected}" />
                    <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource Accent}" />
                    <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                    <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </ToggleButton.Template>
</ToggleButton>
