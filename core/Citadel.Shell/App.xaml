<Application
    x:Class="Citadel.Shell.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Citadel.Ui.Controls;assembly=Citadel.Ui"
    xmlns:setting="clr-namespace:Citadel.Setting;assembly=Citadel.Setting"
    xmlns:theme="clr-namespace:Citadel.Ui.Theme;assembly=Citadel.Ui">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- These dictionaries have code-behind and initialize their own BAML.
                     Merge the typed instances so WPF does not parse the same
                     ResourceDictionary a second time through Source. -->
                <theme:ThemeResources />
                <controls:RailButtonResources />
                <setting:SettingResources />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
