<Window
    x:Class="Citadel.Shell.SettingsWindow"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title=""
    Width="760"
    Height="720"
    MinWidth="640"
    MinHeight="520"
    Icon="Assets/Citadel.ico"
    Background="{DynamicResource BgRail}"
    Foreground="{DynamicResource Fg}"
    ResizeMode="CanResize"
    ShowInTaskbar="False"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterOwner">

    <Border
        Margin="10"
        Background="{DynamicResource Bg}"
        BorderBrush="{DynamicResource Border}"
        BorderThickness="1"
        CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Background="{DynamicResource BgRail}"
                BorderBrush="{DynamicResource Border}"
                BorderThickness="0,0,0,1"
                CornerRadius="11,11,0,0">
                <TextBlock
                    x:Name="PopupTitle"
                    Margin="16,0"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="SettingsWindowTitle"
                    FontFamily="{DynamicResource NavFontFamily}"
                    FontSize="{DynamicResource ContentHeaderFontSize}"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource Fg}" />
            </Border>

            <ContentControl
                x:Name="PopupHost"
                Grid.Row="1"
                AutomationProperties.AutomationId="SettingsWindowHost" />
        </Grid>
    </Border>
</Window>
