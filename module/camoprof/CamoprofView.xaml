<UserControl x:Class="Module.Camoprof.CamoprofView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:setting="clr-namespace:Citadel.Setting.Components;assembly=Citadel.Setting"
             Background="{DynamicResource Bg}"
             Foreground="{DynamicResource Fg}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <Grid>
        <setting:SettingTabs x:Name="WorkspaceTabs"
                             SelectedIndex="0"
                             SelectionChanged="WorkspaceTabs_SelectionChanged">
            <TabItem x:Name="LauncherPanel" Header="Launcher">
                <ContentControl x:Name="LauncherHost" />
            </TabItem>
            <TabItem x:Name="EditorPanel" Header="Editor">
                <Grid />
            </TabItem>
            <TabItem x:Name="RuntimePanel" Header="Runtime">
                <ContentControl x:Name="RuntimeHost" />
            </TabItem>
        </setting:SettingTabs>
    </Grid>
</UserControl>
