<UserControl x:Class="Module.Camoprof.CamoprofView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:setting="clr-namespace:Citadel.Setting.Components;assembly=Citadel.Setting"
             Background="{DynamicResource Bg}"
             Foreground="{DynamicResource Fg}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <!--
      CamoProf: camoufox profile homes. Python is only invoked when a browser
      must live; listing and deleting are plain filesystem work. Colours come
      from the shell's theme resources — the screen declares no palette.
    -->
    <UserControl.Resources>
        <Style x:Key="ProfileListItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource SidebarItemCornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Selected}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4">

            <!-- RUNTIME -->
            <StackPanel x:Name="RuntimePanel" Margin="0,0,0,20">
                <TextBlock Text="RUNTIME"
                           Foreground="{DynamicResource Body}"
                           FontSize="{DynamicResource SettingBodyFontSize}"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Python" />
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="PythonMark" Text="…" />
                    <TextBlock Grid.Row="0" Grid.Column="2" x:Name="PythonDetail" Foreground="{DynamicResource Body}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="venv" />
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="VenvMark" Text="…" />
                    <TextBlock Grid.Row="1" Grid.Column="2" x:Name="VenvDetail" Foreground="{DynamicResource Body}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="packages" />
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="PackagesMark" Text="…" />
                    <TextBlock Grid.Row="2" Grid.Column="2" x:Name="PackagesDetail" Foreground="{DynamicResource Body}" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="browser" />
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="BrowserMark" Text="…" />
                    <TextBlock Grid.Row="3" Grid.Column="2" x:Name="BrowserDetail" Foreground="{DynamicResource Body}" />
                </Grid>

                <StackPanel Orientation="Horizontal">
                    <setting:SettingButton x:Name="SetupButton"
                                           Content="Setup runtime"
                                           Click="SetupButton_Click" />
                    <ProgressBar x:Name="SetupProgress"
                                 Width="180"
                                 Height="6"
                                 Margin="12,0,0,0"
                                 VerticalAlignment="Center"
                                 IsIndeterminate="True"
                                 Visibility="Collapsed" />
                </StackPanel>
                <TextBlock x:Name="SetupStatus"
                           Foreground="{DynamicResource Body}"
                           FontSize="12"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>

            <!-- PROFILES -->
            <Grid Margin="0,0,0,8">
                <TextBlock Text="PROFILES"
                           Foreground="{DynamicResource Body}"
                           FontSize="{DynamicResource SettingBodyFontSize}"
                           FontWeight="SemiBold" />
                <setting:SettingButton x:Name="RefreshButton"
                                       Content="Refresh"
                                       HorizontalAlignment="Right"
                                       Click="RefreshButton_Click" />
            </Grid>

            <ListBox x:Name="ProfileList"
                     ItemContainerStyle="{StaticResource ProfileListItemStyle}"
                     Background="{DynamicResource TransparentBrush}"
                     BorderBrush="{DynamicResource Border}"
                     BorderThickness="1"
                     SelectionChanged="ProfileList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Name}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding LastWrite}"
                                       Foreground="{DynamicResource Body}" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding SizeText}"
                                       Foreground="{DynamicResource Body}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,6">
                <setting:SettingField x:Name="NewProfileName"
                                      Placeholder="nama profile baru"
                                      Width="220" />
                <setting:SettingButton x:Name="AddButton"
                                       Content="Add &amp; login"
                                       Margin="10,0,0,0"
                                       Click="AddButton_Click" />
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <setting:SettingButton x:Name="LaunchButton"
                                       Content="Launch"
                                       IsEnabled="False"
                                       Click="LaunchButton_Click" />
                <setting:SettingButton x:Name="VerifyButton"
                                       Content="Verify login"
                                       Margin="10,0,0,0"
                                       IsEnabled="False"
                                       Click="VerifyButton_Click" />
                <setting:SettingButton x:Name="DeleteButton"
                                       Content="Delete"
                                       Margin="10,0,0,0"
                                       IsEnabled="False"
                                       Click="DeleteButton_Click" />
            </StackPanel>

            <TextBlock x:Name="StatusText"
                       Foreground="{DynamicResource Body}"
                       FontSize="12"
                       Margin="0,8,0,0"
                       TextWrapping="Wrap"
                       Text="login di jendela browser yang terbuka, lalu tekan Verify login — pindah screen menutup browser" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
