<setting:SettingDialog
    x:Class="Module.Camoprof.Launcher.AccountSetupDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:setting="clr-namespace:Citadel.Setting.Components;assembly=Citadel.Setting"
    Title="CamoProf account"
    Width="520">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Google account"
                   FontSize="16"
                   FontWeight="SemiBold" />
        <TextBlock x:Name="InstructionText"
                   Grid.Row="1"
                   Margin="0,6,0,14"
                   Foreground="{DynamicResource Body}"
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <setting:SettingButton x:Name="DetectButton"
                                   Content="Detect account"
                                   Click="DetectButton_Click"
                                   AutomationProperties.Name="Detect active Google account" />
            <TextBlock x:Name="AccountText"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Text="Not detected" />
        </StackPanel>

        <StackPanel x:Name="PasswordPanel"
                    Grid.Row="3"
                    Margin="0,14,0,0"
                    Visibility="Collapsed">
            <TextBlock Margin="0,0,0,6"
                       Foreground="{DynamicResource Body}"
                       Text="Password for automatic relog" />
            <setting:SettingPasswordField x:Name="PasswordField"
                                          AutomationProperties.Name="Password for automatic Google relog" />
        </StackPanel>

        <Grid Grid.Row="4" Margin="0,16,0,0">
            <TextBlock x:Name="StatusText"
                       Margin="0,0,12,0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource Body}"
                       TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <setting:SettingButton x:Name="SaveButton"
                                       Content="Save profile"
                                       IsEnabled="False"
                                       Click="SaveButton_Click"
                                       AutomationProperties.Name="Save detected Google account" />
                <setting:SettingButton x:Name="CancelButton"
                                       Margin="8,0,0,0"
                                       Content="Cancel"
                                       Click="CancelButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</setting:SettingDialog>
