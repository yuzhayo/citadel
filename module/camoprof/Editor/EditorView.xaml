<UserControl x:Class="Module.Camoprof.Editor.EditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:setting="clr-namespace:Citadel.Setting.Components;assembly=Citadel.Setting"
             Background="{DynamicResource Bg}"
             Foreground="{DynamicResource Fg}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style x:Key="ProfileListItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource SidebarItemCornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Selected}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="4,14,4,4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Profile editor"
                   FontSize="16"
                   FontWeight="SemiBold" />

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <setting:SettingField x:Name="NewProfileName"
                                  Placeholder="profile name"
                                  MinWidth="220"
                                  Margin="0,0,10,0"
                                  AutomationProperties.Name="New profile name" />
            <setting:SettingButton x:Name="AddButton"
                                   Grid.Column="1"
                                   Content="Add &amp; login"
                                   Click="AddButton_Click"
                                   AutomationProperties.Name="Add profile and open login browser" />
        </Grid>

        <TextBlock x:Name="StatusText"
                   Grid.Row="2"
                   Margin="0,8,0,12"
                   Foreground="{DynamicResource Body}"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Visibility="Collapsed" />

        <Grid x:Name="ProfileArea"
              Grid.Row="3"
              Visibility="Collapsed">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                <Grid MinWidth="680">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Padding="10,7"
                            BorderBrush="{DynamicResource Border}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="220" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Saved profiles" Foreground="{DynamicResource Body}" />
                            <TextBlock Grid.Column="1" Text="Modified" Foreground="{DynamicResource Body}" />
                            <TextBlock Grid.Column="2" Text="Size" Foreground="{DynamicResource Body}" />
                            <TextBlock Grid.Column="3" Text="Action" Foreground="{DynamicResource Body}" />
                        </Grid>
                    </Border>

                    <ListBox x:Name="ProfileList"
                             Grid.Row="1"
                             ItemContainerStyle="{StaticResource ProfileListItemStyle}"
                             Background="{DynamicResource TransparentBrush}"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             AutomationProperties.Name="Saved CamoProf profiles">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="210" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding LastWrite}"
                                               Foreground="{DynamicResource Body}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding SizeText}"
                                               Foreground="{DynamicResource Body}"
                                               VerticalAlignment="Center" />
                                    <setting:SettingButton Grid.Column="3"
                                                           Content="Delete"
                                                           Tag="{Binding}"
                                                           Click="DeleteButton_Click"
                                                           AutomationProperties.Name="Delete saved profile" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </ScrollViewer>

        </Grid>
    </Grid>
</UserControl>
