<setting:SettingDialog
    x:Class="Module.Camoprof.Features.AddProfile.AddProfileDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:setting="clr-namespace:Citadel.Setting.Components;assembly=Citadel.Setting"
    Title="Add profile"
    Width="520">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Google account"
                   FontSize="16"
                   FontWeight="SemiBold" />
        <!-- Instruction flips from "preparing" to the login instruction
             only after the service reports the listener ARMED — the user
             is never told to type before capture is live. -->
        <TextBlock x:Name="InstructionText"
                   Grid.Row="1"
                   Margin="0,6,0,14"
                   Foreground="{DynamicResource Body}"
                   TextWrapping="Wrap"
                   Text="Preparing the browser…" />
        <TextBlock x:Name="StatusText"
                   Grid.Row="2"
                   Foreground="{DynamicResource Body}"
                   TextWrapping="Wrap"
                   Text="" />
        <StackPanel Grid.Row="3"
                    Margin="0,16,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <setting:SettingButton x:Name="CancelButton"
                                   Content="Cancel"
                                   Click="CancelButton_Click"
                                   AutomationProperties.Name="Cancel Google enrollment" />
        </StackPanel>
    </Grid>
</setting:SettingDialog>
