<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\Citizen.targets" />

  <!--
    Shared C# source (PyHost client + RuntimeSetup + CredenzPath), compiled
    into this citizen — plan D3. Internal helpers only; no contract types.
  -->
  <ItemGroup>
    <Compile Include="..\sharedLogic\cs\**\*.cs" />
  </ItemGroup>

  <!--
    CamoProf's pyhost feature plugins deploy beside the shared pyhost
    payload. PyhostPluginName is the importable package name; the C# host
    activates it via CITADEL_PYHOST_PLUGINS at spawn.
  -->
  <PropertyGroup>
    <PyhostPluginName>camoprof_add_profile</PyhostPluginName>
    <PyhostPluginFeature>AddProfile</PyhostPluginFeature>
  </PropertyGroup>

</Project>
