<UserControl x:Class="Module.Proxy.ProxyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:setting="clr-namespace:Citadel.Setting.Components;assembly=Citadel.Setting"
             Background="{DynamicResource Bg}"
             Foreground="{DynamicResource Fg}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <setting:SettingTabs x:Name="WorkspaceTabs"
                         setting:UiPreference.Key="proxy.workspace.tab"
                         SelectedIndex="0">
        <TabItem x:Name="PoolPanel" Header="Pool">
            <ContentControl x:Name="PoolHost" />
        </TabItem>
        <TabItem x:Name="SyncPanel" Header="Sync">
            <ContentControl x:Name="SyncHost" />
        </TabItem>
        <TabItem x:Name="SettingsPanel" Header="Settings">
            <ContentControl x:Name="SettingsHost" />
        </TabItem>
    </setting:SettingTabs>
</UserControl>
