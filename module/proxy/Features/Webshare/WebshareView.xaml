<UserControl x:Class="Module.Proxy.Features.Webshare.WebshareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:setting="clr-namespace:Citadel.Setting.Components;assembly=Citadel.Setting"
             Background="{DynamicResource Bg}"
             Foreground="{DynamicResource Fg}">
    <setting:SettingViewport Mode="Document">
        <StackPanel>
            <setting:SettingActionCard>
                <StackPanel>
                    <TextBlock Text="Webshare API keys" FontWeight="SemiBold" />
                    <TextBlock x:Name="KeySummaryText"
                               Margin="0,4,0,0"
                               Foreground="{DynamicResource Body}"
                               TextWrapping="Wrap" />
                    <setting:SettingPasswordField x:Name="ApiKeyField"
                                                  Margin="0,8,0,0"
                                                  Width="420"
                                                  HorizontalAlignment="Left"
                                                  AutomationProperties.Name="Webshare API keys" />
                    <TextBlock Margin="0,4,0,0"
                               Foreground="{DynamicResource Dim}"
                               Text="Paste one or more keys separated by comma, whitespace, or a new line. Keys are encrypted in Credenz."
                               TextWrapping="Wrap" />
                </StackPanel>
                <setting:SettingActionCard.ActionContent>
                    <StackPanel Orientation="Horizontal">
                        <setting:SettingButton Content="Add keys"
                                               Click="AddKeysButton_Click"
                                               AutomationProperties.Name="Add Webshare API keys" />
                        <setting:SettingButton x:Name="ProcessButton"
                                               Margin="8,0,0,0"
                                               Content="Process"
                                               Click="ProcessButton_Click"
                                               AutomationProperties.Name="Process Webshare proxy list" />
                        <setting:SettingButton x:Name="StopButton"
                                               Margin="8,0,0,0"
                                               Content="Stop"
                                               Click="StopButton_Click"
                                               AutomationProperties.Name="Stop Webshare import" />
                        <setting:SettingButton Margin="8,0,0,0"
                                               Content="Clear keys"
                                               Click="ClearKeysButton_Click"
                                               AutomationProperties.Name="Clear saved Webshare API keys" />
                    </StackPanel>
                </setting:SettingActionCard.ActionContent>
            </setting:SettingActionCard>

            <Border Margin="0,8,0,0" Padding="12" Style="{DynamicResource SettingCardStyle}">
                <StackPanel>
                    <TextBlock x:Name="StatusText"
                               Foreground="{DynamicResource Body}"
                               TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite" />
                    <ProgressBar x:Name="ProgressBar"
                                 Margin="0,8,0,0"
                                 Height="6"
                                 Minimum="0"
                                 Maximum="1"
                                 Value="0" />
                    <TextBlock x:Name="DetailText"
                               Margin="0,8,0,0"
                               Foreground="{DynamicResource Body}"
                               Text="Webshare does not run until Process is pressed."
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </setting:SettingViewport>
</UserControl>
