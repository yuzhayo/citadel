<UserControl x:Class="Module.Proxy.Features.Sync.SyncView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:setting="clr-namespace:Citadel.Setting.Components;assembly=Citadel.Setting"
             Background="{DynamicResource Bg}"
             Foreground="{DynamicResource Fg}">
    <setting:SettingViewport Mode="Document">
        <StackPanel>
            <setting:SettingActionCard>
                <StackPanel>
                    <TextBlock Text="Proxy sync" FontWeight="SemiBold" />
                    <TextBlock x:Name="StatusText"
                               Margin="0,4,0,0"
                               Foreground="{DynamicResource Body}"
                               Text="Ready. Existing pool is kept until a sync commits."
                               TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <setting:SettingActionCard.ActionContent>
                    <StackPanel Orientation="Horizontal">
                        <setting:SettingButton x:Name="StartButton"
                                               Content="Start sync"
                                               Click="StartButton_Click"
                                               AutomationProperties.Name="Start proxy sync" />
                        <setting:SettingButton x:Name="StopButton"
                                               Margin="8,0,0,0"
                                               Content="Stop"
                                               IsEnabled="False"
                                               Click="StopButton_Click"
                                               AutomationProperties.Name="Stop proxy sync" />
                    </StackPanel>
                </setting:SettingActionCard.ActionContent>
            </setting:SettingActionCard>

            <Border Margin="0,8,0,0"
                    Padding="12"
                    Style="{DynamicResource SettingCardStyle}">
                <StackPanel>
                    <ProgressBar x:Name="ProgressBar"
                                 Height="6"
                                 IsIndeterminate="False"
                                 Minimum="0"
                                 Maximum="1"
                                 Value="0" />
                    <TextBlock x:Name="DetailText"
                               Margin="0,8,0,0"
                               Foreground="{DynamicResource Body}"
                               Text="No sync has run in this session."
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </setting:SettingViewport>
</UserControl>
