<UserControl x:Class="Module.Yuzvid.Features.Runtime.YuzvidRuntimeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:setting="clr-namespace:Citadel.Setting.Components;assembly=Citadel.Setting"
             Background="{DynamicResource Bg}"
             Foreground="{DynamicResource Fg}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <setting:SettingViewport Mode="Document">
        <StackPanel>
            <Grid>
                <StackPanel>
                    <TextBlock Text="WebView2 runtime"
                               FontSize="16"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Browser engine used by the embedded browser tab."
                               Margin="0,4,0,0"
                               Foreground="{DynamicResource Body}"
                               FontSize="12" />
                </StackPanel>
                <setting:SettingButton x:Name="RefreshButton"
                                       Content="Refresh status"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Top"
                                       Click="RefreshButton_Click"
                                       AutomationProperties.Name="Refresh WebView2 status" />
            </Grid>

            <Border Margin="0,16,0,12"
                    Padding="16"
                    Style="{DynamicResource SettingCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Runtime" Margin="0,3" />
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="RuntimeMark" Text="…" Margin="0,3" />
                    <TextBlock Grid.Row="0" Grid.Column="2" x:Name="RuntimeDetail"
                               Foreground="{DynamicResource Body}" Margin="0,3" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="SDK" Margin="0,3" />
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="SdkMark" Text="…" Margin="0,3" />
                    <TextBlock Grid.Row="1" Grid.Column="2" x:Name="SdkDetail"
                               Foreground="{DynamicResource Body}" Margin="0,3" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Browser state" Margin="0,3" />
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="StateMark" Text="…" Margin="0,3" />
                    <TextBlock Grid.Row="2" Grid.Column="2" x:Name="StateDetail"
                               Foreground="{DynamicResource Body}" Margin="0,3" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Proxy" Margin="0,3" />
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="ProxyMark" Text="…" Margin="0,3" />
                    <TextBlock Grid.Row="3" Grid.Column="2" x:Name="ProxyDetail"
                               Foreground="{DynamicResource Body}" Margin="0,3" TextWrapping="Wrap" />
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal">
                <setting:SettingButton x:Name="RetryButton"
                                       Content="Retry browser init"
                                       Click="RetryButton_Click"
                                       AutomationProperties.Name="Retry WebView2 initialization" />
            </StackPanel>

            <TextBlock x:Name="StatusText"
                       Margin="0,8,0,0"
                       Foreground="{DynamicResource Body}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Text="Status is checked when this tab opens." />
        </StackPanel>
    </setting:SettingViewport>
</UserControl>
