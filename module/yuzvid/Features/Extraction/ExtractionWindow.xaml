<Window x:Class="Module.Yuzvid.Features.Extraction.ExtractionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:setting="clr-namespace:Citadel.Setting.Components;assembly=Citadel.Setting"
        Title=""
        Width="820"
        Height="640"
        MinWidth="560"
        MinHeight="420"
        Background="{DynamicResource BgRail}"
        Foreground="{DynamicResource Fg}"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Border Margin="10"
            Background="{DynamicResource Bg}"
            BorderBrush="{DynamicResource Border}"
            BorderThickness="1"
            CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header. The OS caption bar stays (like SettingsWindow); Title is
                 blank so only this in-window title + status show, and the
                 system close button is the single close affordance. -->
            <Border Grid.Row="0"
                    Background="{DynamicResource BgRail}"
                    BorderBrush="{DynamicResource Border}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="11,11,0,0">
                <StackPanel Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="Extraction"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Fg}"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusText"
                               Margin="12,0,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource Dim}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Toolbar -->
            <setting:SettingActionCard Grid.Row="1" Margin="12,10,12,0">
                <setting:SettingActionCard.Content>
                    <StackPanel>
                        <WrapPanel>
                            <setting:SettingButton x:Name="QueueSelectedButton"
                                                   Content="Queue selected (0)"
                                                   MinWidth="160"
                                                   Click="QueueSelected_Click" />
                            <setting:SettingButton x:Name="CopySelectedButton"
                                                   Content="Copy selected"
                                                   MinWidth="130" Margin="10,0,0,0"
                                                   Click="CopySelected_Click" />
                            <setting:SettingButton x:Name="SelectAllButton"
                                                   Content="Select all"
                                                   MinWidth="110" Margin="10,0,0,0"
                                                   Click="SelectAll_Click" />
                            <setting:SettingButton x:Name="ClearButton"
                                                   Content="Clear selection"
                                                   MinWidth="130" Margin="10,0,0,0"
                                                   Click="Clear_Click" />
                        </WrapPanel>
                        <!-- P2: manual page-URL input. Paste a NORMAL page URL; the parent
                             navigates there and runs extraction on the loaded page. -->
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <setting:SettingField x:Name="ManualUrlBox"
                                                  Width="480" Height="34"
                                                  Placeholder="Tempel URL halaman (bukan link CDN) — lalu Enter"
                                                  PreviewKeyDown="ManualUrlBox_PreviewKeyDown"
                                                  AutomationProperties.Name="Manual page URL" />
                            <setting:SettingButton x:Name="ManualUrlGoButton"
                                                   Content="Ambil &amp; Extract"
                                                   MinWidth="130" Margin="10,0,0,0"
                                                   Click="ManualUrlGo_Click"
                                                   AutomationProperties.Name="Extract from manual URL" />
                        </StackPanel>
                    </StackPanel>
                </setting:SettingActionCard.Content>
                <setting:SettingActionCard.ActionContent>
                    <setting:SettingButton x:Name="RescanButton"
                                           MinWidth="120"
                                           Click="RescanButton_Click"
                                           AutomationProperties.Name="Re-scan halaman">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" />
                            <TextBlock Text="Re-scan" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </setting:SettingButton>
                </setting:SettingActionCard.ActionContent>
            </setting:SettingActionCard>

            <!-- Link table (shared SettingTable) -->
            <Border Grid.Row="2"
                    Margin="12,10,12,0"
                    Style="{DynamicResource SettingCardStyle}">
                <Grid>
                    <setting:SettingTable x:Name="LinkTable"
                                          setting:UiPreference.Key="yuzvid.extraction.table"
                                          AutomationProperties.Name="Extracted links"
                                          CanUserSortColumns="False">
                        <setting:SettingTable.InteractiveColumns>
                            <!-- Mirrors MangaReader queue: checkbox + chevron + name in one
                                 Title column; group headers are tri-state and expandable. -->
                            <DataGridTemplateColumn Header="Title" Width="*" MinWidth="240">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      VerticalAlignment="Center" Tag="{Binding}"
                                                      AutomationProperties.Name="Select link or group" />
                                            <setting:SettingButton Content="{Binding Chevron}" Click="Expand_Click"
                                                                   Tag="{Binding}" Margin="6,0,6,0" MinWidth="28"
                                                                   Visibility="{Binding IsGroup, Converter={StaticResource BoolToVis}}"
                                                                   AutomationProperties.Name="Expand or collapse group" />
                                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Title}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Info" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding CountText}" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Dim}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Version" Width="70" Binding="{Binding Version}" />
                            <DataGridTextColumn Header="Server" Width="110" Binding="{Binding Server}" />

                            <DataGridTemplateColumn Header="Link" Width="220">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Detail}" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Dim}"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Action" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    Visibility="{Binding IsLink, Converter={StaticResource BoolToVis}}">
                                            <setting:SettingButton Content="Copy"
                                                                   MinWidth="60" Margin="0,0,4,0"
                                                                   Click="RowCopy_Click" Tag="{Binding}" />
                                            <setting:SettingButton Content="Queue"
                                                                   MinWidth="60"
                                                                   Click="RowQueue_Click" Tag="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </setting:SettingTable.InteractiveColumns>
                    </setting:SettingTable>

                    <TextBlock x:Name="EmptyText"
                               Text="Belum ada link — klik Re-scan."
                               Foreground="{DynamicResource Dim}"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Visible" />
                </Grid>
            </Border>

            <!-- Footer -->
            <TextBlock Grid.Row="3"
                       x:Name="FooterText"
                       Margin="16,8,16,12"
                       Foreground="{DynamicResource Dim}"
                       FontSize="11"
                       Text="0 link" />
        </Grid>
    </Border>
</Window>
