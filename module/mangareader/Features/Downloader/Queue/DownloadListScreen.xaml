<UserControl x:Class="Module.Mangareader.Features.Downloader.Queue.DownloadListScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:setting="clr-namespace:Citadel.Setting.Components;assembly=Citadel.Setting"
             Background="{DynamicResource Bg}"
             Foreground="{DynamicResource Fg}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <setting:SettingViewport Mode="Contained">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <setting:SettingActionCard>
                <setting:SettingActionCard.Content>
                    <StackPanel Orientation="Horizontal">
                        <setting:SettingButton x:Name="BackButton"
                                               MinWidth="140"
                                               Content="Back to Catalog"
                                               Click="BackButton_Click"
                                               AutomationProperties.Name="Back to catalog" />
                        <setting:SettingButton x:Name="ClearCompletedButton"
                                               MinWidth="140"
                                               Margin="10,0,0,0"
                                               Content="Clear completed"
                                               Click="ClearCompletedButton_Click"
                                               AutomationProperties.Name="Clear completed jobs" />
                        <setting:SettingButton x:Name="ResumeButton"
                                               MinWidth="100"
                                               Margin="10,0,0,0"
                                               Content="Resume"
                                               Click="ResumeButton_Click"
                                               AutomationProperties.Name="Resume paused and failed jobs" />
                    </StackPanel>
                </setting:SettingActionCard.Content>
                <setting:SettingActionCard.ActionContent>
                    <TextBlock x:Name="SummaryText"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Body}"
                               Text="No jobs" />
                </setting:SettingActionCard.ActionContent>
            </setting:SettingActionCard>

            <Border Grid.Row="1"
                    Margin="0,10,0,0"
                    Style="{DynamicResource SettingCardStyle}">
                <Grid>
                    <!-- Sorting is opt-in and presentation-only: the shared
                         table sorts its collection view, never the durable
                         queue order. The Action column is never sortable. -->
                    <setting:SettingTable x:Name="JobTable"
                                          CanUserSortColumns="True"
                                          AutomationProperties.Name="Download queue">
                        <setting:SettingTable.InteractiveColumns>
                            <DataGridTemplateColumn Header="Title"
                                                    CanUserSort="True"
                                                    SortMemberPath="TitleDisplayName"
                                                    MinWidth="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TitleDisplayName}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding TitleDisplayName}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Chapter"
                                                    CanUserSort="True"
                                                    SortMemberPath="ChapterDisplayName"
                                                    MinWidth="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ChapterDisplayName}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding ChapterDisplayName}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Group"
                                                    CanUserSort="True"
                                                    SortMemberPath="GroupDisplayName"
                                                    MinWidth="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding GroupDisplayName}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding GroupDisplayName}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Status"
                                                    CanUserSort="True"
                                                    SortMemberPath="State"
                                                    MinWidth="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StateText}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Progress"
                                                    CanUserSort="True"
                                                    SortMemberPath="CompletedPages"
                                                    MinWidth="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ProgressText}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Detail"
                                                    CanUserSort="False"
                                                    MinWidth="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Warning}"
                                                   Foreground="{DynamicResource Dim}"
                                                   TextWrapping="Wrap" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Action"
                                                    CanUserSort="False"
                                                    MinWidth="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <!--
                                          Exactly one of the four state actions is
                                          valid for any job state, so the column can
                                          never stack overlapping controls. Row
                                          actions stay owned by the queue; this cell
                                          only offers them.
                                        -->
                                        <setting:SettingTableActions>
                                            <setting:SettingTableActions.PrimaryContent>
                                                <Grid>
                                                    <setting:SettingButton MinWidth="88"
                                                                           AutomationProperties.Name="Pause job"
                                                                           Click="PauseResume_Click"
                                                                           Content="Pause"
                                                                           IsEnabled="{Binding CanActNow}"
                                                                           Tag="{Binding}"
                                                                           Visibility="{Binding CanPause, Converter={StaticResource BoolToVisibility}}" />
                                                    <setting:SettingButton MinWidth="88"
                                                                           AutomationProperties.Name="{Binding ResumeActionLabel}"
                                                                           Click="PauseResume_Click"
                                                                           Content="{Binding ResumeActionLabel}"
                                                                           IsEnabled="{Binding CanActNow}"
                                                                           Tag="{Binding}"
                                                                           Visibility="{Binding CanResume, Converter={StaticResource BoolToVisibility}}" />
                                                    <setting:SettingButton MinWidth="118"
                                                                           AutomationProperties.Name="Choose fallback source group"
                                                                           Click="ChooseSource_Click"
                                                                           Content="Choose source"
                                                                           IsEnabled="{Binding CanActNow}"
                                                                           Tag="{Binding}"
                                                                           Visibility="{Binding CanChooseFallback, Converter={StaticResource BoolToVisibility}}" />
                                                    <setting:SettingButton MinWidth="104"
                                                                           AutomationProperties.Name="Open published folder"
                                                                           Click="OpenFolder_Click"
                                                                           Content="Open folder"
                                                                           Tag="{Binding}"
                                                                           Visibility="{Binding CanOpenFolder, Converter={StaticResource BoolToVisibility}}" />
                                                </Grid>
                                            </setting:SettingTableActions.PrimaryContent>
                                            <setting:SettingTableActions.SecondaryContent>
                                                <setting:SettingButton MinWidth="80"
                                                                       AutomationProperties.Name="Remove job"
                                                                       Click="Remove_Click"
                                                                       Content="Remove"
                                                                       Tag="{Binding}" />
                                            </setting:SettingTableActions.SecondaryContent>
                                        </setting:SettingTableActions>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </setting:SettingTable.InteractiveColumns>
                    </setting:SettingTable>

                    <TextBlock x:Name="EmptyText"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="16"
                               FontWeight="SemiBold"
                               IsHitTestVisible="False"
                               Text="No queued chapters."
                               Visibility="Collapsed" />
                </Grid>
            </Border>

            <TextBlock x:Name="StatusText"
                       Grid.Row="2"
                       Margin="2,10,2,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource Accent}"
                       Visibility="Collapsed"
                       AutomationProperties.LiveSetting="Polite" />
        </Grid>
    </setting:SettingViewport>
</UserControl>
