<UserControl x:Class="Module.Mangareader.Features.Downloader.Catalog.CatalogScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:setting="clr-namespace:Citadel.Setting.Components;assembly=Citadel.Setting"
             xmlns:manga="clr-namespace:Module.Mangareader"
             xmlns:mangacomponents="clr-namespace:Module.Mangareader.Components"
             Background="{DynamicResource Bg}"
             Foreground="{DynamicResource Fg}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <setting:SettingViewport Mode="Contained">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Query and provider-process lifecycle keep separate cards on one
                 row. Provider-owned filters use a third card below with the same
                 compact shared-card settings. -->
            <Grid x:Name="ProviderControlsPanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <setting:SettingActionCard Margin="0,0,8,8" Padding="10,5">
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox x:Name="SourcePicker"
                                  MinWidth="150"
                                  Height="34"
                                  Margin="0,0,8,0"
                                  Style="{DynamicResource SettingComboBoxStyle}"
                                  DisplayMemberPath="DisplayName"
                                  AutomationProperties.Name="Web target"
                                  SelectionChanged="SourcePicker_SelectionChanged" />

                        <setting:SettingField x:Name="SearchField"
                                              Width="220"
                                              Height="34"
                                              Margin="0,0,8,0"
                                              Placeholder="Search titles"
                                              AutomationProperties.Name="Search titles"
                                              KeyDown="SearchField_KeyDown" />

                        <setting:SettingButton x:Name="SearchButton"
                                               MinWidth="88"
                                               Height="34"
                                               Margin="0,0,8,0"
                                               Content="Search"
                                               Click="SearchButton_Click"
                                               AutomationProperties.Name="Search catalog with current filters" />
                        <setting:SettingButton x:Name="ManualButton"
                                               MinWidth="88"
                                               Height="34"
                                               Content="Manual"
                                               Click="ManualButton_Click"
                                               AutomationProperties.Name="Open manual title URL" />
                    </WrapPanel>
                </setting:SettingActionCard>

                <setting:SettingActionCard Grid.Column="1" Padding="10,5">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <setting:SettingToggle x:Name="ShowBrowserToggle"
                                               Margin="0,0,8,0"
                                               IsChecked="False"
                                               ToolTip="Show browser while loading; off uses the Downloader's headless browser"
                                               AutomationProperties.Name="Show browser while loading catalog">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Text="&#xE946;" />
                        </setting:SettingToggle>
                        <setting:SettingButton x:Name="StartButton"
                                               MinWidth="96"
                                               Height="34"
                                               Margin="0,0,8,0"
                                               Content="Start"
                                               Click="StartButton_Click"
                                               AutomationProperties.Name="Start provider browser process" />
                        <setting:SettingButton x:Name="StopButton"
                                               MinWidth="96"
                                               Height="34"
                                               Content="Stop"
                                               Click="StopButton_Click"
                                               AutomationProperties.Name="Stop provider browser process" />
                    </StackPanel>
                </setting:SettingActionCard>

                <setting:SettingActionCard Grid.Row="1"
                                           Grid.ColumnSpan="2"
                                           Padding="10,5">
                    <ContentControl x:Name="FilterHost" VerticalAlignment="Center" />
                </setting:SettingActionCard>
            </Grid>

            <Grid Grid.Row="1">
                <!-- Result grid -->
                <Grid x:Name="ResultsPanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer x:Name="ResultsScroll"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Style="{DynamicResource SettingScrollViewerStyle}">
                        <ItemsControl x:Name="ResultsList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <manga:MangaTitleCard Margin="0,0,12,12"
                                                          Tag="{Binding}"
                                                          Click="TitleCard_Click" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <setting:SettingButton x:Name="LoadMoreButton"
                                           Grid.Row="1"
                                           MinWidth="140"
                                           Margin="0,10,0,0"
                                           HorizontalAlignment="Center"
                                           Content="Load more"
                                           IsEnabled="False"
                                           Click="LoadMoreButton_Click"
                                           AutomationProperties.Name="Load more results" />

                    <StackPanel x:Name="ResultsEmptyPanel"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="440"
                                Visibility="Collapsed">
                        <TextBlock x:Name="ResultsEmptyTitle"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Text="No results yet" />
                        <TextBlock x:Name="ResultsEmptyDetail"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Foreground="{DynamicResource Body}"
                                   Text="Choose a web target, then press Start. Opening this tab and editing filters never sends a request." />
                    </StackPanel>
                </Grid>

                <!-- Title detail replaces the grid; Back restores it exactly. -->
                <Grid x:Name="DetailPanel" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <mangacomponents:MangaDetailView x:Name="Detail"
                                                         MaxHeight="300"
                                                         Cover="{Binding Cover}"
                                                         Metadata="{Binding Metadata}"
                                                         Synopsis="{Binding SynopsisText}"
                                                         Title="{Binding Title}">
                            <mangacomponents:MangaDetailView.HeaderLeadingContent>
                                <setting:SettingButton MinWidth="120"
                                                       HorizontalAlignment="Left"
                                                       Content="Back to results"
                                                       Click="BackButton_Click"
                                                       AutomationProperties.Name="Back to catalog results" />
                            </mangacomponents:MangaDetailView.HeaderLeadingContent>
                        </mangacomponents:MangaDetailView>

                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   Margin="0,0,10,0"
                                   Foreground="{DynamicResource Body}"
                                   Text="Source group" />
                        <ComboBox x:Name="GroupPicker"
                                  Grid.Column="1"
                                  Height="40"
                                  Margin="0,0,12,0"
                                  Style="{DynamicResource SettingComboBoxStyle}"
                                  DisplayMemberPath="DisplayName"
                                  AutomationProperties.Name="Source group"
                                  SelectionChanged="GroupPicker_SelectionChanged" />
                        <setting:SettingButton x:Name="QueueButton"
                                               Grid.Column="2"
                                               Height="40"
                                               MinWidth="160"
                                               Content="Queue selected"
                                               IsEnabled="False"
                                               Click="QueueButton_Click"
                                               AutomationProperties.Name="Queue selected chapters" />
                    </Grid>

                    <!--
                      Lister's read-only filesystem verdict for this title. It is
                      refreshed when the detail opens, when the source group
                      changes and when the user returns to the detail — never on a
                      timer — so a file added or removed outside a stale Library
                      view is reflected immediately.
                    -->
                    <TextBlock x:Name="LocalAvailabilityText"
                               Grid.Row="2"
                               Margin="2,10,2,0"
                               AutomationProperties.LiveSetting="Polite"
                               FontSize="12"
                               Foreground="{DynamicResource Body}"
                               TextWrapping="Wrap"
                               Visibility="Collapsed" />

                    <!--
                      Chapter Selection renders through the shared sortable table.
                      Sorting is presentation-only: it reorders the collection view
                      and never changes a chapter identity or the durable queue
                      order. A chapter already present locally is dimmed but stays
                      selectable, because re-downloading one variant is allowed.
                    -->
                    <setting:SettingTable x:Name="ChapterTable"
                                          Grid.Row="3"
                                          Margin="0,12,0,0"
                                          AutomationProperties.Name="Chapters of the selected group"
                                          CanUserSortColumns="True">
                        <setting:SettingTable.InteractiveColumns>
                            <!--
                              A chapter already present locally is dimmed across
                              every cell, checkbox included, but stays enabled and
                              selectable: re-downloading one variant is allowed.
                              The dimming is applied per cell because the row
                              container belongs to the shared table and is never
                              restyled here. Opacity is visual only, so it cannot
                              change hit testing.
                            -->
                            <DataGridTemplateColumn CanUserSort="False" MinWidth="48">
                                <DataGridTemplateColumn.Header>
                                    <CheckBox AutomationProperties.Name="Select all visible chapters"
                                              HorizontalAlignment="Center"
                                              IsThreeState="True"
                                              VerticalAlignment="Center" />
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox AutomationProperties.Name="{Binding DisplayName}"
                                                  HorizontalAlignment="Center"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Opacity="{Binding AvailabilityOpacity}"
                                                  VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn CanUserSort="True"
                                                    Header="Chapter"
                                                    MinWidth="240"
                                                    Width="*"
                                                    SortMemberPath="DisplayName">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Opacity="{Binding AvailabilityOpacity}"
                                                   Text="{Binding DisplayName}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding DisplayName}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn CanUserSort="True"
                                                    Header="Number"
                                                    MinWidth="90"
                                                    SortMemberPath="ChapterSortKey">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Opacity="{Binding AvailabilityOpacity}"
                                                   Text="{Binding ChapterNumber}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn CanUserSort="True"
                                                    Header="Local"
                                                    MinWidth="130"
                                                    SortMemberPath="IsLocallyAvailable">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Foreground="{DynamicResource Dim}"
                                                   Opacity="{Binding AvailabilityOpacity}"
                                                   Text="{Binding AvailabilityText}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </setting:SettingTable.InteractiveColumns>
                    </setting:SettingTable>

                    </Grid>
                </Grid>
            </Grid>

            <TextBlock x:Name="StatusText"
                       Grid.Row="2"
                       Margin="2,10,2,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource Accent}"
                       Visibility="Collapsed"
                       AutomationProperties.LiveSetting="Polite" />
        </Grid>
    </setting:SettingViewport>
</UserControl>
