<UserControl x:Class="Module.Mangareader.Features.Downloader.Catalog.CatalogScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:setting="clr-namespace:Citadel.Setting.Components;assembly=Citadel.Setting"
             xmlns:manga="clr-namespace:Module.Mangareader"
             Background="{DynamicResource Bg}"
             Foreground="{DynamicResource Fg}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <!-- Object-backed chapter items must expose a real accessible name.
             This derives from the shared item style and adds only that binding:
             the shared template, hover, selected and focus behavior stay owned
             by setting/, and nothing is copied into this screen. -->
        <Style x:Key="DownloaderChapterItemStyle"
               TargetType="{x:Type ListBoxItem}"
               BasedOn="{StaticResource SettingListItemStyle}">
            <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
        </Style>
    </UserControl.Resources>

    <setting:SettingViewport Mode="Contained">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Toolbar: provider, search, filters toggle, Start, remote state,
                 and the only entry point to Download List. -->
            <setting:SettingActionCard>
                <setting:SettingActionCard.Content>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ComboBox x:Name="SourcePicker"
                                  MinWidth="150"
                                  Height="40"
                                  Style="{DynamicResource SettingComboBoxStyle}"
                                  DisplayMemberPath="DisplayName"
                                  AutomationProperties.Name="Web target"
                                  SelectionChanged="SourcePicker_SelectionChanged" />

                        <setting:SettingField x:Name="SearchField"
                                              Grid.Column="1"
                                              Height="40"
                                              Margin="10,0,0,0"
                                              Placeholder="Search titles (no request until Start)"
                                              AutomationProperties.Name="Search titles"
                                              KeyDown="SearchField_KeyDown" />

                        <setting:SettingToggle x:Name="FiltersToggle"
                                               Grid.Column="2"
                                               Margin="10,0,0,0"
                                               Content="Advanced Filters"
                                               AutomationProperties.Name="Advanced Filters"
                                               Checked="FiltersToggle_Changed"
                                               Unchecked="FiltersToggle_Changed" />

                        <setting:SettingButton x:Name="StartButton"
                                               Grid.Column="3"
                                               MinWidth="92"
                                               Height="40"
                                               Margin="10,0,0,0"
                                               Content="Start"
                                               Click="StartButton_Click"
                                               AutomationProperties.Name="Start catalog request" />
                    </Grid>
                </setting:SettingActionCard.Content>
                <setting:SettingActionCard.ActionContent>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="RemoteStateText"
                                   Margin="0,0,12,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Body}"
                                   Text="Idle — no request"
                                   AutomationProperties.LiveSetting="Polite" />
                        <setting:SettingButton x:Name="DownloadListButton"
                                               MinWidth="140"
                                               Content="Download List (0)"
                                               Click="DownloadListButton_Click"
                                               AutomationProperties.Name="Open download list" />
                    </StackPanel>
                </setting:SettingActionCard.ActionContent>
            </setting:SettingActionCard>

            <!-- Provider-owned filter composition, hosted but never interpreted
                 by this screen. -->
            <ContentControl x:Name="FilterHost"
                            Grid.Row="1"
                            Margin="0,10,0,0"
                            Visibility="Collapsed" />

            <Grid Grid.Row="2" Margin="0,10,0,0">
                <!-- Result grid -->
                <Grid x:Name="ResultsPanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer x:Name="ResultsScroll"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Style="{DynamicResource SettingScrollViewerStyle}">
                        <ItemsControl x:Name="ResultsList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <manga:MangaTitleCard Margin="0,0,12,12"
                                                          Tag="{Binding}"
                                                          Click="TitleCard_Click" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <setting:SettingButton x:Name="LoadMoreButton"
                                           Grid.Row="1"
                                           MinWidth="140"
                                           Margin="0,10,0,0"
                                           HorizontalAlignment="Center"
                                           Content="Load more"
                                           IsEnabled="False"
                                           Click="LoadMoreButton_Click"
                                           AutomationProperties.Name="Load more results" />

                    <StackPanel x:Name="ResultsEmptyPanel"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="440"
                                Visibility="Collapsed">
                        <TextBlock x:Name="ResultsEmptyTitle"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Text="No results yet" />
                        <TextBlock x:Name="ResultsEmptyDetail"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Foreground="{DynamicResource Body}"
                                   Text="Choose a web target, then press Start. Opening this tab and editing filters never sends a request." />
                    </StackPanel>
                </Grid>

                <!-- Title detail replaces the grid; Back restores it exactly. -->
                <Grid x:Name="DetailPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <setting:SettingButton x:Name="BackButton"
                                           MinWidth="120"
                                           HorizontalAlignment="Left"
                                           Content="Back to results"
                                           Click="BackButton_Click"
                                           AutomationProperties.Name="Back to catalog results" />

                    <StackPanel x:Name="DetailHeader" Grid.Row="1" Margin="0,12,0,0" />

                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   Margin="0,0,10,0"
                                   Foreground="{DynamicResource Body}"
                                   Text="Source group" />
                        <ComboBox x:Name="GroupPicker"
                                  Grid.Column="1"
                                  Height="40"
                                  Style="{DynamicResource SettingComboBoxStyle}"
                                  DisplayMemberPath="DisplayName"
                                  AutomationProperties.Name="Source group"
                                  SelectionChanged="GroupPicker_SelectionChanged" />
                    </Grid>

                    <ListBox x:Name="ChapterList"
                             Grid.Row="3"
                             Margin="0,12,0,0"
                             Style="{DynamicResource SettingListStyle}"
                             ItemContainerStyle="{StaticResource DownloaderChapterItemStyle}"
                             SelectionMode="Extended"
                             AutomationProperties.Name="Chapters of the selected group"
                             SelectionChanged="ChapterList_SelectionChanged" />

                    <setting:SettingButton x:Name="QueueButton"
                                           Grid.Row="4"
                                           MinWidth="160"
                                           Margin="0,12,0,0"
                                           HorizontalAlignment="Right"
                                           Content="Queue selected"
                                           IsEnabled="False"
                                           Click="QueueButton_Click"
                                           AutomationProperties.Name="Queue selected chapters" />
                </Grid>
            </Grid>

            <TextBlock x:Name="StatusText"
                       Grid.Row="3"
                       Margin="2,10,2,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource Accent}"
                       Visibility="Collapsed"
                       AutomationProperties.LiveSetting="Polite" />
        </Grid>
    </setting:SettingViewport>
</UserControl>
