<UserControl x:Class="Module.Mangareader.Features.Downloader.Sources.Comix.ComixFilterPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:setting="clr-namespace:Citadel.Setting.Components;assembly=Citadel.Setting"
             Foreground="{DynamicResource Fg}">
    <UserControl.Resources>
        <!-- Every option list here is object-backed, so each derives from the
             shared item style and adds only the accessible-name binding. The
             shared template and its hover/selected/focus behavior stay owned by
             setting/ and are not copied here. -->
        <Style x:Key="ComixOptionItemStyle"
               TargetType="{x:Type ListBoxItem}"
               BasedOn="{StaticResource SettingListItemStyle}">
            <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
        </Style>
    </UserControl.Resources>

    <!-- Provider-owned Advanced Filters, composed only from existing shared
         controls. Nothing here knows about the queue, and no shared control
         learns anything about Comix. -->
    <Border Style="{DynamicResource SettingCardStyle}">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Content rating"
                               FontSize="12"
                               Foreground="{DynamicResource Dim}" />
                    <ListBox x:Name="RatingList"
                             Margin="0,5,0,0"
                             MaxHeight="120"
                             Style="{DynamicResource SettingListStyle}"
                             ItemContainerStyle="{StaticResource ComixOptionItemStyle}"
                             SelectionMode="Extended"
                             AutomationProperties.Name="Content rating" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Type"
                               FontSize="12"
                               Foreground="{DynamicResource Dim}" />
                    <ListBox x:Name="TypeList"
                             Margin="0,5,0,0"
                             MaxHeight="120"
                             Style="{DynamicResource SettingListStyle}"
                             ItemContainerStyle="{StaticResource ComixOptionItemStyle}"
                             SelectionMode="Extended"
                             AutomationProperties.Name="Type" />
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock Text="Demographic"
                               FontSize="12"
                               Foreground="{DynamicResource Dim}" />
                    <ListBox x:Name="DemographicList"
                             Margin="0,5,0,0"
                             MaxHeight="120"
                             Style="{DynamicResource SettingListStyle}"
                             ItemContainerStyle="{StaticResource ComixOptionItemStyle}"
                             SelectionMode="Extended"
                             AutomationProperties.Name="Demographic" />
                </StackPanel>

                <StackPanel Grid.Column="3">
                    <TextBlock Text="Release status"
                               FontSize="12"
                               Foreground="{DynamicResource Dim}" />
                    <ListBox x:Name="StatusList"
                             Margin="0,5,0,0"
                             MaxHeight="120"
                             Style="{DynamicResource SettingListStyle}"
                             ItemContainerStyle="{StaticResource ComixOptionItemStyle}"
                             SelectionMode="Extended"
                             AutomationProperties.Name="Release status" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <setting:SettingField x:Name="GenreSearchField"
                                              Height="38"
                                              Margin="0,0,8,0"
                                              Placeholder="Search genres, then press Search"
                                              AutomationProperties.Name="Search genres" />
                        <setting:SettingButton x:Name="GenreSearchButton"
                                               Grid.Column="1"
                                               MinWidth="80"
                                               Height="38"
                                               Margin="0,0,8,0"
                                               Content="Search"
                                               Click="GenreSearchButton_Click"
                                               AutomationProperties.Name="Search genres" />
                        <setting:SettingButton x:Name="GenreModeButton"
                                               Grid.Column="2"
                                               MinWidth="80"
                                               Height="38"
                                               Content="AND"
                                               Click="GenreModeButton_Click"
                                               AutomationProperties.Name="Genre match mode" />
                    </Grid>
                    <ListBox x:Name="GenreList"
                             Margin="0,8,0,0"
                             MaxHeight="140"
                             Style="{DynamicResource SettingListStyle}"
                             ItemContainerStyle="{StaticResource ComixOptionItemStyle}"
                             SelectionMode="Extended"
                             AutomationProperties.Name="Resolved genres" />
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <setting:SettingField x:Name="FormatSearchField"
                                              Height="38"
                                              Margin="0,0,8,0"
                                              Placeholder="Search formats, then press Search"
                                              AutomationProperties.Name="Search formats" />
                        <setting:SettingButton x:Name="FormatSearchButton"
                                               Grid.Column="1"
                                               MinWidth="80"
                                               Height="38"
                                               Content="Search"
                                               Click="FormatSearchButton_Click"
                                               AutomationProperties.Name="Search formats" />
                    </Grid>
                    <ListBox x:Name="FormatList"
                             Margin="0,8,0,0"
                             MaxHeight="140"
                             Style="{DynamicResource SettingListStyle}"
                             ItemContainerStyle="{StaticResource ComixOptionItemStyle}"
                             SelectionMode="Extended"
                             AutomationProperties.Name="Resolved formats" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Minimum chapter"
                               FontSize="12"
                               Foreground="{DynamicResource Dim}" />
                    <setting:SettingField x:Name="MinChapterField"
                                          Height="38"
                                          Margin="0,5,0,0"
                                          Placeholder="Any"
                                          AutomationProperties.Name="Minimum chapter"
                                          TextChanged="MinChapterField_TextChanged" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Release year from"
                               FontSize="12"
                               Foreground="{DynamicResource Dim}" />
                    <setting:SettingField x:Name="YearFromField"
                                          Height="38"
                                          Margin="0,5,0,0"
                                          Placeholder="Any"
                                          AutomationProperties.Name="Release year from"
                                          TextChanged="YearField_TextChanged" />
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock Text="Release year to"
                               FontSize="12"
                               Foreground="{DynamicResource Dim}" />
                    <setting:SettingField x:Name="YearToField"
                                          Height="38"
                                          Margin="0,5,0,0"
                                          Placeholder="Any"
                                          AutomationProperties.Name="Release year to"
                                          TextChanged="YearField_TextChanged" />
                </StackPanel>

                <StackPanel Grid.Column="3">
                    <TextBlock Text="Sort"
                               FontSize="12"
                               Foreground="{DynamicResource Dim}" />
                    <ComboBox x:Name="SortPicker"
                              Height="38"
                              Margin="0,5,0,0"
                              Style="{DynamicResource SettingComboBoxStyle}"
                              DisplayMemberPath="DisplayName"
                              AutomationProperties.Name="Sort order"
                              SelectionChanged="SortPicker_SelectionChanged" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <setting:SettingField x:Name="AuthorField"
                                              Height="38"
                                              Margin="0,0,8,0"
                                              Placeholder="Author, then press Search"
                                              AutomationProperties.Name="Author" />
                        <setting:SettingButton x:Name="AuthorSearchButton"
                                               Grid.Column="1"
                                               MinWidth="80"
                                               Height="38"
                                               Content="Search"
                                               Click="AuthorSearchButton_Click"
                                               AutomationProperties.Name="Search authors" />
                    </Grid>
                    <ListBox x:Name="AuthorList"
                             Margin="0,8,0,0"
                             MaxHeight="110"
                             Style="{DynamicResource SettingListStyle}"
                             ItemContainerStyle="{StaticResource ComixOptionItemStyle}"
                             AutomationProperties.Name="Resolved authors"
                             SelectionChanged="AuthorList_SelectionChanged" />
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <setting:SettingField x:Name="ArtistField"
                                              Height="38"
                                              Margin="0,0,8,0"
                                              Placeholder="Artist, then press Search"
                                              AutomationProperties.Name="Artist" />
                        <setting:SettingButton x:Name="ArtistSearchButton"
                                               Grid.Column="1"
                                               MinWidth="80"
                                               Height="38"
                                               Content="Search"
                                               Click="ArtistSearchButton_Click"
                                               AutomationProperties.Name="Search artists" />
                    </Grid>
                    <ListBox x:Name="ArtistList"
                             Margin="0,8,0,0"
                             MaxHeight="110"
                             Style="{DynamicResource SettingListStyle}"
                             ItemContainerStyle="{StaticResource ComixOptionItemStyle}"
                             AutomationProperties.Name="Resolved artists"
                             SelectionChanged="ArtistList_SelectionChanged" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ValidationText"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource Dim}" />
                <setting:SettingButton x:Name="ResetButton"
                                       Grid.Column="1"
                                       MinWidth="92"
                                       Content="Reset"
                                       Click="ResetButton_Click"
                                       AutomationProperties.Name="Reset filters to provider defaults" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
