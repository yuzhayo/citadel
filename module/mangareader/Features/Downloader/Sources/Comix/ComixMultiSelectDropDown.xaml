<UserControl x:Class="Module.Mangareader.Features.Downloader.Sources.Comix.ComixMultiSelectDropDown"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:setting="clr-namespace:Citadel.Setting.Components;assembly=Citadel.Setting"
             Background="{DynamicResource TransparentBrush}"
             Foreground="{DynamicResource Fg}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <!--
      Compact checkbox dropdown: a composition of the shared button, the shared
      auto-fade scroll viewer and ordinary framework checkboxes inside an
      ordinary popup. It adds no new rendering or interaction primitive — the
      shared button keeps its own hover/press/focus/disabled behavior and the
      popup keeps its own outside-click dismissal.

      It owns draft selection state only. It never issues a request, and editing
      a checkbox here must not trigger a Browse.
    -->
    <Grid>
        <setting:SettingButton x:Name="ToggleButton"
                               MinWidth="118"
                               Height="34"
                               Click="ToggleButton_Click"
                               Padding="10,0" />

        <Popup x:Name="OptionsPopup"
               AllowsTransparency="True"
               Placement="Bottom"
               PlacementTarget="{Binding ElementName=ToggleButton}"
               PopupAnimation="Fade"
               StaysOpen="False">
            <Border Margin="0,4,0,0"
                    Padding="10,8"
                    Background="{DynamicResource Bg}"
                    BorderBrush="{DynamicResource Border}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource SidebarItemCornerRadius}">
                <ScrollViewer MaxHeight="280"
                              HorizontalScrollBarVisibility="Disabled"
                              Style="{DynamicResource SettingScrollViewerStyle}"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="OptionList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Margin="0,3"
                                          AutomationProperties.Name="{Binding DisplayName}"
                                          Click="Option_CheckClicked"
                                          Content="{Binding DisplayName}"
                                          Foreground="{DynamicResource Fg}"
                                          IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Popup>
    </Grid>
</UserControl>
