<UserControl x:Class="Module.Mangareader.Features.Downloader.ManualUrl.ManualUrlScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:setting="clr-namespace:Citadel.Setting.Components;assembly=Citadel.Setting"
             Background="{DynamicResource Bg}"
             Foreground="{DynamicResource Fg}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <setting:SettingViewport Mode="Contained">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <setting:SettingActionCard Padding="10,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <setting:SettingButton MinWidth="88"
                                           Height="34"
                                           Margin="0,0,8,0"
                                           Content="Back"
                                           Click="BackButton_Click"
                                           AutomationProperties.Name="Back to downloader" />
                    <setting:SettingField x:Name="UrlField"
                                          Grid.Column="1"
                                          Height="34"
                                          Placeholder="Paste a supported title URL"
                                          AutomationProperties.Name="Manual title URL"
                                          KeyDown="UrlField_KeyDown" />
                    <setting:SettingButton x:Name="LoadButton"
                                           Grid.Column="2"
                                           MinWidth="88"
                                           Height="34"
                                           Margin="8,0,0,0"
                                           Content="Enter"
                                           Click="LoadButton_Click"
                                           AutomationProperties.Name="Open manual title URL" />
                </Grid>
            </setting:SettingActionCard>

            <TextBlock x:Name="StatusText"
                       Grid.Row="1"
                       Margin="2,10,2,0"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"
                       AutomationProperties.LiveSetting="Polite" />

            <StackPanel Grid.Row="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="460">
                <TextBlock FontSize="17"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Text="Open title from URL" />
                <TextBlock Margin="0,8,0,0"
                           Foreground="{DynamicResource Body}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Text="Paste a direct title link, then press Enter. Supported providers are checked in order without changing Downloader search, filters, or browser controls." />
            </StackPanel>
        </Grid>
    </setting:SettingViewport>
</UserControl>
