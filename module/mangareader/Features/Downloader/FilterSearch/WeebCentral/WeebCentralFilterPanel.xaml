<UserControl x:Class="Module.Mangareader.Features.Downloader.FilterSearch.WeebCentral.WeebCentralFilterPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mangacomponents="clr-namespace:Module.Mangareader.Components"
             xmlns:setting="clr-namespace:Citadel.Setting.Components;assembly=Citadel.Setting"
             Foreground="{DynamicResource Fg}">
    <WrapPanel Orientation="Horizontal">
        <ComboBox x:Name="SortPicker"
                  setting:UiPreference.Key="mangareader.downloader.weebcentral.sort"
                  MinWidth="150"
                  Height="34"
                  Margin="0,0,8,8"
                  AutomationProperties.Name="WeebCentral sort order"
                  DisplayMemberPath="DisplayName"
                  SelectionChanged="DraftFilter_Changed"
                  Style="{DynamicResource SettingComboBoxStyle}" />

        <ComboBox x:Name="OrderPicker"
                  setting:UiPreference.Key="mangareader.downloader.weebcentral.order"
                  MinWidth="130"
                  Height="34"
                  Margin="0,0,8,8"
                  AutomationProperties.Name="WeebCentral order"
                  DisplayMemberPath="DisplayName"
                  SelectionChanged="DraftFilter_Changed"
                  Style="{DynamicResource SettingComboBoxStyle}" />

        <mangacomponents:MangaMultiSelectFilter x:Name="StatusFilter"
                                                 setting:UiPreference.Key="mangareader.downloader.weebcentral.filter.status"
                                                 Margin="0,0,8,8"
                                                 Header="Status"
                                                 SelectionChanged="DraftFilter_Changed" />

        <mangacomponents:MangaMultiSelectFilter x:Name="TypeFilter"
                                                 setting:UiPreference.Key="mangareader.downloader.weebcentral.filter.type"
                                                 Margin="0,0,8,8"
                                                 Header="Type"
                                                 SelectionChanged="DraftFilter_Changed" />

        <mangacomponents:MangaMultiSelectFilter x:Name="TagFilter"
                                                 setting:UiPreference.Key="mangareader.downloader.weebcentral.filter.tags"
                                                 Margin="0,0,8,8"
                                                 Header="Tags"
                                                 SelectionChanged="DraftFilter_Changed" />

        <setting:SettingButton x:Name="AdvancedButton"
                               MinWidth="140"
                               Height="34"
                               Margin="0,0,0,8"
                               AutomationProperties.Name="WeebCentral advanced filters"
                               Click="AdvancedButton_Click"
                               Content="Advanced Filters" />

        <Popup x:Name="AdvancedPopup"
               AllowsTransparency="True"
               Placement="Bottom"
               PlacementTarget="{Binding ElementName=AdvancedButton}"
               PopupAnimation="Fade"
               StaysOpen="False">
            <Border Width="460"
                    Margin="0,4,0,0"
                    Padding="14,12"
                    Background="{DynamicResource Bg}"
                    BorderBrush="{DynamicResource Border}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource SidebarItemCornerRadius}">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="0,0,10,0">
                            <TextBlock FontSize="12"
                                       Foreground="{DynamicResource Dim}"
                                       Text="Adult content" />
                            <ComboBox x:Name="AdultPicker"
                                      setting:UiPreference.Key="mangareader.downloader.weebcentral.filter.adult"
                                      Height="34"
                                      Margin="0,4,0,0"
                                      AutomationProperties.Name="Adult content"
                                      DisplayMemberPath="DisplayName"
                                      SelectionChanged="DraftFilter_Changed"
                                      Style="{DynamicResource SettingComboBoxStyle}" />
                        </StackPanel>
                    </Grid>

                    <setting:SettingButton HorizontalAlignment="Right"
                                           MinWidth="80"
                                           Height="34"
                                           AutomationProperties.Name="Reset WeebCentral filters"
                                           Click="ResetButton_Click"
                                           Content="Reset" />

                    <TextBlock x:Name="ValidationText"
                               Margin="0,8,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource Dim}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Popup>
    </WrapPanel>
</UserControl>
