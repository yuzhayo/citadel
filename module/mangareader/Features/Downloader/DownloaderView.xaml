<UserControl x:Class="Module.Mangareader.Features.Downloader.DownloaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:catalog="clr-namespace:Module.Mangareader.Features.Downloader.Catalog"
             xmlns:manual="clr-namespace:Module.Mangareader.Features.Downloader.ManualUrl"
             Background="{DynamicResource Bg}"
             Foreground="{DynamicResource Fg}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <!-- Queue remains a top-level MangaReader tab. This host only routes
         Downloader Catalog and the dedicated Manual URL entry screen. -->
    <Grid>
        <catalog:CatalogScreen x:Name="CatalogScreen" />
        <manual:ManualUrlScreen x:Name="ManualUrlScreen" Visibility="Collapsed" />
    </Grid>
</UserControl>
