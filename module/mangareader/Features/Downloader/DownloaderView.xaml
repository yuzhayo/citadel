<UserControl x:Class="Module.Mangareader.Features.Downloader.DownloaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:catalog="clr-namespace:Module.Mangareader.Features.Downloader.Catalog"
             Background="{DynamicResource Bg}"
             Foreground="{DynamicResource Fg}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <!-- One routed child: the online Catalog. The Queue screen is hosted once
         as a top-level tab by the MangaReader parent; this host only relays
         the request to navigate there. Hiding a screen never disposes the
         queue or the provider session. -->
    <Grid>
        <catalog:CatalogScreen x:Name="CatalogScreen" />
    </Grid>
</UserControl>
