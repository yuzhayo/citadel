<UserControl x:Class="Module.Mangareader.Components.MangaDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Module.Mangareader.Components"
             Background="{DynamicResource TransparentBrush}"
             Foreground="{DynamicResource Fg}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <!--
      Shared manga-detail composition: one cover/text arrangement reused by the
      Library local-detail adapter and the Downloader remote-detail adapter. It
      is a composition of existing Citadel primitives only — shared card style,
      shared auto-fade scroll viewer, ordinary text and image elements — and it
      adds no new rendering or input behavior.

      It receives typed display data and caller-owned action content. It performs
      no local or remote data access and imports no feature type.
    -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ContentPresenter Margin="0,0,14,0"
                          VerticalAlignment="Center"
                          Content="{Binding HeaderLeadingContent, RelativeSource={RelativeSource AncestorType=local:MangaDetailView}}" />

        <TextBlock Grid.Column="1"
                   VerticalAlignment="Center"
                   AutomationProperties.Name="{Binding Title, RelativeSource={RelativeSource AncestorType=local:MangaDetailView}}"
                   FontSize="19"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource Fg}"
                   Text="{Binding Title, RelativeSource={RelativeSource AncestorType=local:MangaDetailView}}"
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="1" Margin="0,8,14,0">
            <Border Width="132"
                    Height="180"
                    Background="{DynamicResource Card}"
                    BorderBrush="{DynamicResource Border}"
                    BorderThickness="1"
                    ClipToBounds="True"
                    CornerRadius="{DynamicResource SidebarItemCornerRadius}">
                <Grid>
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="30"
                               Foreground="{DynamicResource Dim}"
                               Text="&#xE736;" />
                    <Image RenderOptions.BitmapScalingMode="Fant"
                           Source="{Binding Cover, RelativeSource={RelativeSource AncestorType=local:MangaDetailView}}"
                           Stretch="UniformToFill" />
                </Grid>
            </Border>

            <!-- Caller-owned actions below the cover. -->
            <ContentPresenter Margin="0,10,0,0"
                              Content="{Binding CoverActions, RelativeSource={RelativeSource AncestorType=local:MangaDetailView}}" />
        </StackPanel>

        <Border Grid.Row="1"
                Grid.Column="1"
                Margin="0,8,0,0"
                Style="{DynamicResource SettingCardStyle}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly"
                          Style="{DynamicResource SettingScrollViewerStyle}"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock FontSize="12"
                               Foreground="{DynamicResource Body}"
                               Text="{Binding Synopsis, RelativeSource={RelativeSource AncestorType=local:MangaDetailView}}"
                               TextWrapping="Wrap" />

                    <ItemsControl Margin="0,12,0,0"
                                  ItemsSource="{Binding Metadata, RelativeSource={RelativeSource AncestorType=local:MangaDetailView}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="118" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontSize="12"
                                               Foreground="{DynamicResource Dim}"
                                               Text="{Binding Label}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1"
                                               FontSize="12"
                                               Foreground="{DynamicResource Body}"
                                               Text="{Binding DisplayValue}"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Caller-owned actions in the detail area, before Grouping. -->
                    <ContentPresenter Margin="0,10,0,0"
                                      Content="{Binding DetailActions, RelativeSource={RelativeSource AncestorType=local:MangaDetailView}}" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
