<Button x:Class="Module.Mangareader.MangaTitleCard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Module.Mangareader"
        Width="220"
        Height="330"
        Padding="0"
        Background="{DynamicResource Card}"
        BorderThickness="0"
        Foreground="{DynamicResource Fg}"
        HorizontalContentAlignment="Stretch"
        VerticalContentAlignment="Stretch"
        AutomationProperties.Name="{Binding Title}">
    <Button.Template>
        <ControlTemplate TargetType="{x:Type local:MangaTitleCard}">
            <Border x:Name="Surface"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{DynamicResource Border}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{DynamicResource SidebarItemCornerRadius}"
                    ClipToBounds="True"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Surface" Property="Opacity" Value="0.94" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Accent}" />
                    <Setter TargetName="Surface" Property="BorderThickness" Value="2" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Button.Template>

    <Grid Background="{DynamicResource Bg}" ClipToBounds="True">
        <TextBlock Text="&#xE736;"
                   FontFamily="Segoe MDL2 Assets"
                   FontSize="36"
                   Foreground="{DynamicResource Dim}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />

        <Image Source="{Binding Cover}"
               Stretch="Fill"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"
               RenderOptions.BitmapScalingMode="Fant" />

        <Border Margin="9"
                Padding="8,4"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Background="#D9111215"
                CornerRadius="10">
            <TextBlock Text="{Binding ChapterCountText}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="White" />
        </Border>

        <Border Height="92"
                VerticalAlignment="Bottom">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="#00000000" />
                    <GradientStop Offset="0.34" Color="#B0000000" />
                    <GradientStop Offset="1" Color="#F2000000" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="10,22,10,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Text="{Binding Title}"
                           Height="38"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="White"
                           LineHeight="19"
                           TextWrapping="Wrap"
                           ClipToBounds="True"
                           VerticalAlignment="Top"
                           ToolTip="{Binding Title}" />
                <TextBlock Grid.Row="1"
                           Text="{Binding ProgressText}"
                           FontSize="11"
                           Foreground="#FFD2D2D2"
                           TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Button>
