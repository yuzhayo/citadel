<UserControl x:Class="Module.Mangareader.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Module.Mangareader"
             xmlns:setting="clr-namespace:Citadel.Setting.Components;assembly=Citadel.Setting"
             Background="{DynamicResource Bg}"
             Foreground="{DynamicResource Fg}">
    <Grid Margin="0,16,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource Card}"
                BorderBrush="{DynamicResource Border}"
                BorderThickness="1"
                CornerRadius="{DynamicResource ShellCardRadius}"
                Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <setting:SettingField x:Name="LibraryPath"
                                      Grid.Column="0"
                                      Height="40"
                                      Margin="0,0,8,0"
                                      Placeholder="Choose the folder that contains manga title folders" />
                <setting:SettingButton x:Name="BrowseButton"
                                       Grid.Column="1"
                                       MinWidth="94"
                                       Height="40"
                                       Margin="0,0,8,0"
                                       Click="BrowseButton_Click"
                                       Content="Browse" />
                <setting:SettingButton x:Name="ScanButton"
                                       Grid.Column="2"
                                       MinWidth="82"
                                       Height="40"
                                       Click="ScanButton_Click"
                                       Content="Scan" />
            </Grid>
        </Border>

        <TextBlock x:Name="StatusText"
                   Grid.Row="1"
                   Margin="4,10"
                   Foreground="{DynamicResource Body}"
                   FontSize="13"
                   Text="Choose a library folder to begin." />

        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly">
                <ItemsControl x:Name="TitleGrid">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <local:MangaTitleCard Margin="0,0,12,12"
                                                  Tag="{Binding}"
                                                  Click="TitleCard_Click" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border x:Name="EmptyPanel"
                    Background="{DynamicResource TransparentBrush}">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="420">
                    <TextBlock x:Name="EmptyTitle"
                               Text="No manga scanned"
                               FontSize="18"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyDetail"
                               Margin="0,8,0,0"
                               Text="Choose a library folder. Each child folder containing CBZ files becomes one title card."
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Foreground="{DynamicResource Body}" />
                </StackPanel>
            </Border>

            <local:ChapterSelectorView x:Name="ChapterSelector"
                                       Panel.ZIndex="20"
                                       ChapterSelected="ChapterSelector_ChapterSelected" />
        </Grid>
    </Grid>
</UserControl>
