<UserControl x:Class="Module.Mangareader.ChapterSelectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:Module.Mangareader.Components"
             xmlns:setting="clr-namespace:Citadel.Setting.Components;assembly=Citadel.Setting"
             Background="{DynamicResource Bg}"
             Foreground="{DynamicResource Fg}"
             Visibility="Collapsed"
             Focusable="True"
             PreviewKeyDown="View_PreviewKeyDown">
    <Border Background="{DynamicResource Bg}"
            BorderBrush="{DynamicResource Border}"
            BorderThickness="1"
            CornerRadius="{DynamicResource ShellCardRadius}"
            Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--
              Shared local title detail, fed by a Library-owned adapter. Its two
              reserved action regions are assigned in code-behind: Library's
              Update Checker fills the cover slot and Library's Grouping fills
              the detail slot. They stay empty until their own feature slice
              does, so no dead affordance is shown here.
            -->
            <components:MangaDetailView x:Name="Detail"
                                        MaxHeight="300"
                                        Cover="{Binding Cover}"
                                        Metadata="{Binding Metadata}"
                                        Synopsis="{Binding SynopsisText}"
                                        Title="{Binding Title}">
                <components:MangaDetailView.HeaderLeadingContent>
                    <setting:SettingButton Width="38"
                                           Height="38"
                                           HorizontalAlignment="Left"
                                           AutomationProperties.Name="Back to Library"
                                           Click="BackButton_Click"
                                           Padding="0"
                                           ToolTip="Back to Library">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   Text="&#xE72B;" />
                    </setting:SettingButton>
                </components:MangaDetailView.HeaderLeadingContent>
            </components:MangaDetailView>

            <TextBlock Grid.Row="1"
                       Margin="2,15,2,8"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Text="Choose a chapter" />

            <ListBox x:Name="ChapterList"
                     Grid.Row="2"
                     Background="{DynamicResource Card}"
                     BorderBrush="{DynamicResource Border}"
                     BorderThickness="1"
                     MouseDoubleClick="ChapterList_MouseDoubleClick"
                     Padding="6"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     SelectionChanged="ChapterList_SelectionChanged"
                     Style="{DynamicResource SettingListStyle}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontWeight="SemiBold"
                                       Text="{Binding Title}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1"
                                       Margin="14,0,0,0"
                                       Foreground="{DynamicResource Dim}"
                                       Text="Open" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <setting:SettingButton x:Name="OpenButton"
                                   Grid.Row="3"
                                   MinWidth="128"
                                   Height="38"
                                   Margin="0,14,0,0"
                                   HorizontalAlignment="Right"
                                   Click="OpenButton_Click"
                                   Content="Open chapter" />
        </Grid>
    </Border>
</UserControl>
