<UserControl x:Class="Module.Mangareader.Library.Grouping.GroupingBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:setting="clr-namespace:Citadel.Setting.Components;assembly=Citadel.Setting"
             Background="{DynamicResource TransparentBrush}"
             Foreground="{DynamicResource Fg}">
    <!--
      Library's group tab/action area. It is presentation for the Grouping
      feature: the shared tab component renders the groups, and every rule about
      names, membership and persistence stays in GroupingFeature.
    -->
    <StackPanel>
        <setting:SettingTabs x:Name="GroupTabs"
                             AutomationProperties.Name="Library groups"
                             SelectionChanged="GroupTabs_SelectionChanged" />
        <TextBlock x:Name="GroupStatusText"
                   Margin="2,6,2,0"
                   FontSize="12"
                   Foreground="{DynamicResource Dim}"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"
                   AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
</UserControl>
