<UserControl x:Class="Module.Mangareader.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Module.Mangareader"
             Background="{DynamicResource Bg}"
             Foreground="{DynamicResource Fg}">
    <Grid Margin="0,16,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Margin="4,0,4,10"
                   Text="Recently opened titles"
                   FontSize="13"
                   Foreground="{DynamicResource Body}" />

        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly">
                <ItemsControl x:Name="HistoryGrid">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <local:MangaTitleCard Margin="0,0,12,12"
                                                  Tag="{Binding}"
                                                  Click="HistoryCard_Click" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel x:Name="EmptyPanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="420">
                <TextBlock Text="No reading history"
                           FontSize="18"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock Margin="0,8,0,0"
                           Text="Open a chapter from Library. Its latest reading position will appear here."
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Foreground="{DynamicResource Body}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
