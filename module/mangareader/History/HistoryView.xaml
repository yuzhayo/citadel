<UserControl x:Class="Module.Mangareader.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Module.Mangareader"
             xmlns:components="clr-namespace:Module.Mangareader.Components"
             xmlns:setting="clr-namespace:Citadel.Setting.Components;assembly=Citadel.Setting"
             Background="{DynamicResource Bg}"
             Foreground="{DynamicResource Fg}">
    <setting:SettingViewport Mode="Contained">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
          Compact action bar in the same visual position and pattern as Library.
          It is presentation only: Clear History and the Grid/List preference are
          two independent features, and no clear, pin, retention or persistence
          rule lives in this view.
        -->
        <setting:SettingActionCard Grid.Row="0">
            <setting:SettingActionCard.Content>
                <TextBlock VerticalAlignment="Center"
                           FontSize="13"
                           Foreground="{DynamicResource Body}"
                           Text="Recently opened titles" />
            </setting:SettingActionCard.Content>
            <setting:SettingActionCard.ActionContent>
                <StackPanel Orientation="Horizontal">
                    <components:MangaViewModeSelector x:Name="ViewModeSelector"
                                                      Margin="0,0,12,0"
                                                      VerticalAlignment="Center" />
                    <setting:SettingButton x:Name="ClearHistoryButton"
                                           MinWidth="124"
                                           Height="40"
                                           AutomationProperties.Name="Clear unpinned history"
                                           Click="ClearHistoryButton_Click"
                                           Content="Clear History" />
                </StackPanel>
            </setting:SettingActionCard.ActionContent>
        </setting:SettingActionCard>

        <TextBlock x:Name="StatusText"
                   Grid.Row="1"
                   Margin="2,8,2,0"
                   AutomationProperties.LiveSetting="Polite"
                   FontSize="12"
                   Foreground="{DynamicResource Dim}"
                   TextWrapping="Wrap"
                   Visibility="Collapsed" />

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <ScrollViewer x:Name="GridScroll"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly"
                          Style="{DynamicResource SettingScrollViewerStyle}">
                <ItemsControl x:Name="HistoryGrid">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!--
                              The shared card is reused unchanged; the pin is a
                              sibling overlay in History's own item composition,
                              so no second card primitive is created and clicking
                              the pin cannot open the chapter.
                            -->
                            <Grid Margin="0,0,12,12">
                                <local:MangaTitleCard Tag="{Binding}"
                                                      Click="HistoryCard_Click" />
                                <setting:SettingButton Width="28"
                                                       Height="28"
                                                       Margin="8"
                                                       Padding="0"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Top"
                                                       AutomationProperties.Name="{Binding PinActionName}"
                                                       Click="PinButton_Click"
                                                       Tag="{Binding}"
                                                       ToolTip="{Binding PinActionName}">
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               FontSize="12"
                                               Text="{Binding PinGlyphText}" />
                                </setting:SettingButton>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!--
              List presentation over the same collection, with History-owned
              columns, its own pin icon and its own open action. It shares no
              business contract with Library or with Catalog.
            -->
            <setting:SettingTable x:Name="HistoryTable"
                                  setting:UiPreference.Key="mangareader.history.table"
                                  AutomationProperties.Name="Reading history"
                                  CanUserSortColumns="True"
                                  Visibility="Collapsed">
                <setting:SettingTable.InteractiveColumns>
                    <DataGridTemplateColumn CanUserSort="True"
                                            Header="Pinned"
                                            MinWidth="70"
                                            SortMemberPath="IsPinned">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <setting:SettingButton Width="28"
                                                       Height="28"
                                                       Padding="0"
                                                       AutomationProperties.Name="{Binding PinActionName}"
                                                       Click="PinButton_Click"
                                                       Tag="{Binding}"
                                                       ToolTip="{Binding PinActionName}">
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               FontSize="12"
                                               Text="{Binding PinGlyphText}" />
                                </setting:SettingButton>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn CanUserSort="True"
                                            Header="Title"
                                            MinWidth="200"
                                            SortMemberPath="Title">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock FontWeight="SemiBold"
                                           Text="{Binding Title}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Title}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn CanUserSort="True"
                                            Header="Last read"
                                            MinWidth="160"
                                            SortMemberPath="LastReadText">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding LastReadText}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding LastReadText}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn CanUserSort="True"
                                            Header="Last opened"
                                            MinWidth="140"
                                            SortMemberPath="LastOpenedUtc">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding LastOpenedText}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn CanUserSort="False"
                                            Header="Action"
                                            MinWidth="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <setting:SettingTableActions>
                                    <setting:SettingTableActions.PrimaryContent>
                                        <setting:SettingButton MinWidth="76"
                                                               AutomationProperties.Name="Open this chapter"
                                                               Click="HistoryRow_OpenClick"
                                                               Content="Open"
                                                               Tag="{Binding}" />
                                    </setting:SettingTableActions.PrimaryContent>
                                </setting:SettingTableActions>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </setting:SettingTable.InteractiveColumns>
            </setting:SettingTable>

            <StackPanel x:Name="EmptyPanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="420"
                        IsHitTestVisible="False">
                <TextBlock Text="No reading history"
                           FontSize="18"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock Margin="0,8,0,0"
                           Text="Open a chapter from Library. Its latest reading position will appear here."
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Foreground="{DynamicResource Body}" />
            </StackPanel>
        </Grid>
    </Grid>
    </setting:SettingViewport>
</UserControl>
