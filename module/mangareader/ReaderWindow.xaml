<Window x:Class="Module.Mangareader.ReaderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:setting="clr-namespace:Citadel.Setting.Components;assembly=Citadel.Setting"
        Title="Manga Reader"
        Width="1180"
        Height="760"
        MinWidth="640"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        WindowState="Maximized"
        Background="#05060A"
        Foreground="{DynamicResource Fg}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="ReaderWindow_Loaded"
        Closed="ReaderWindow_Closed"
        PreviewKeyDown="ReaderWindow_PreviewKeyDown">
    <Grid Background="#05060A">
        <ScrollViewer x:Name="ReaderScroller"
                      Visibility="Collapsed"
                      IsEnabled="False"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      IsDeferredScrollingEnabled="False"
                      PanningMode="VerticalOnly"
                      Background="#05060A"
                      SizeChanged="ReaderScroller_SizeChanged">
            <ItemsControl x:Name="PageList"
                          HorizontalAlignment="Center"
                          Background="#05060A">
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="{x:Type ContentPresenter}">
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                        <Setter Property="SnapsToDevicePixels" Value="True" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Image Source="{Binding Bitmap}"
                               Stretch="Uniform"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Top"
                               SnapsToDevicePixels="True"
                               RenderOptions.BitmapScalingMode="Fant" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border x:Name="LoadingPanel"
                Panel.ZIndex="30"
                Background="#05060A">
            <StackPanel Width="420"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock x:Name="LoadingTitle"
                           Text="Preparing chapter"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Fg}"
                           TextAlignment="Center" />
                <TextBlock x:Name="LoadingDetail"
                           Margin="0,10,0,16"
                           Text="Reading CBZ..."
                           FontSize="13"
                           Foreground="{DynamicResource Body}"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
                <ProgressBar x:Name="LoadingProgress"
                             Height="4"
                             Minimum="0"
                             Maximum="1"
                             Value="0"
                             Foreground="{DynamicResource Accent}"
                             Background="{DynamicResource Hover}" />
                <setting:SettingButton x:Name="CloseAfterErrorButton"
                                       Visibility="Collapsed"
                                       Width="100"
                                       Margin="0,18,0,0"
                                       HorizontalAlignment="Center"
                                       Content="Close"
                                       Click="CloseAfterErrorButton_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
