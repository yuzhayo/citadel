<setting:SettingDialog
    x:Class="Module.Agentrouter.Features.Shortcuts.SelectProfilesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:setting="clr-namespace:Citadel.Setting.Components;assembly=Citadel.Setting"
    Title="Select profiles"
    Width="560">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="SummaryText"
                   FontWeight="SemiBold"
                   Text="No profiles added." />

        <TextBlock Grid.Row="1"
                   Margin="0,4,0,12"
                   Foreground="{DynamicResource Body}"
                   TextWrapping="Wrap"
                   Text="Check a profile to point Agentrouter at it, uncheck to drop the pointer. Each change saves immediately. Agentrouter never creates or deletes the CamoProf profile itself." />

        <Border Grid.Row="2"
                MaxHeight="380"
                Padding="0"
                Style="{DynamicResource SettingCardStyle}">
            <Grid>
                <setting:SettingTable x:Name="ProfileTable"
                                      setting:UiPreference.Key="agentrouter.select.table"
                                      CanUserSortColumns="True"
                                      AutomationProperties.Name="CamoProf profiles available for selection">
                    <setting:SettingTable.InteractiveColumns>
                        <DataGridTemplateColumn Header="Add"
                                                CanUserSort="False"
                                                Width="54">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding IsAdded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              AutomationProperties.Name="Add or remove this profile" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Profile"
                                                CanUserSort="True"
                                                SortMemberPath="Account"
                                                SortDirection="Ascending"
                                                MinWidth="240">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Account}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Account}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </setting:SettingTable.InteractiveColumns>
                </setting:SettingTable>

                <TextBlock x:Name="EmptyText"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="15"
                           FontWeight="SemiBold"
                           IsHitTestVisible="False"
                           Text="No CamoProf profiles found."
                           Visibility="Collapsed" />
            </Grid>
        </Border>

        <TextBlock x:Name="StatusText"
                   Grid.Row="3"
                   Margin="0,8,0,0"
                   Foreground="{DynamicResource Body}"
                   TextWrapping="Wrap"
                   Text=""
                   Visibility="Collapsed"
                   AutomationProperties.LiveSetting="Polite" />

        <StackPanel Grid.Row="4"
                    Margin="0,16,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <setting:SettingButton x:Name="CloseButton"
                                   Content="Close"
                                   Click="CloseButton_Click"
                                   AutomationProperties.Name="Close profile selection" />
        </StackPanel>
    </Grid>
</setting:SettingDialog>
