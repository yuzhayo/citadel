<UserControl x:Class="Module.Agentrouter.Features.Shortcuts.ShortcutsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:setting="clr-namespace:Citadel.Setting.Components;assembly=Citadel.Setting"
             Background="{DynamicResource Bg}"
             Foreground="{DynamicResource Fg}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <setting:SettingViewport Mode="Contained">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <setting:SettingActionCard>
                <setting:SettingActionCard.Content>
                    <StackPanel MinWidth="340">
                        <TextBlock x:Name="ProgressTitleText"
                                   FontWeight="SemiBold"
                                   Text="Agent Router · ready" />
                        <ProgressBar x:Name="BatchProgressBar"
                                     Margin="0,8,0,2"
                                     Height="8"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="0"
                                     Visibility="Collapsed" />
                        <TextBlock x:Name="StatusText"
                                   Margin="0,2,0,0"
                                   Foreground="{DynamicResource Body}"
                                   TextWrapping="Wrap"
                                   Text="Pilih operasi untuk memulai."
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </setting:SettingActionCard.Content>
                <setting:SettingActionCard.ActionContent>
                    <StackPanel Orientation="Horizontal">
                        <setting:SettingButton x:Name="SelectProfilesButton"
                                               Content="Select profiles…"
                                               Click="SelectProfilesButton_Click"
                                               AutomationProperties.Name="Select CamoProf profiles to add" />
<setting:SettingButton x:Name="RefreshButton"
                                                Content="Refresh"
                                                Click="RefreshButton_Click"
                                                AutomationProperties.Name="Refresh Agentrouter shortcuts" />
                         <setting:SettingToggle x:Name="ShowBrowserToggle"
                                               setting:UiPreference.Key="agentrouter.launcher.show-browser"
                                               Margin="12,0,0,0"
                                               Content="Show browser while claiming"
                                               IsChecked="False"
                                               ToolTip="Off claims with no visible browser; the sign-in step always opens one"
                                               AutomationProperties.Name="Show browser while claiming" />
                         <setting:SettingButton x:Name="AutoClaimButton"
                                                Content="Claim all"
                                                Margin="12,0,0,0"
                                                Click="AutoClaimButton_Click"
                                                AutomationProperties.Name="Claim the daily reward for every profile" />
                         <setting:SettingButton x:Name="CheckAllBalanceButton"
                                                Content="Check all balance"
                                                Margin="8,0,0,0"
                                                Click="CheckAllBalanceButton_Click"
                                                AutomationProperties.Name="Check balance for all profiles" />
                         <setting:SettingButton x:Name="CheckAllLoginButton"
                                                Content="Check all login"
                                                Margin="8,0,0,0"
                                                Click="CheckAllLoginButton_Click"
                                                AutomationProperties.Name="Check login for all profiles" />
                     </StackPanel>
                </setting:SettingActionCard.ActionContent>
            </setting:SettingActionCard>

            <Border Grid.Row="1"
                    Padding="0"
                    Style="{DynamicResource SettingCardStyle}">
                <Grid>
                    <setting:SettingTable x:Name="ShortcutTable"
                                          setting:UiPreference.Key="agentrouter.shortcuts.table.v2"
                                          CanUserSortColumns="True"
                                          AutomationProperties.Name="Agentrouter profile shortcuts">
                        <setting:SettingTable.InteractiveColumns>
                            <DataGridTemplateColumn Header="Profile"
                                                    CanUserSort="True"
                                                    SortMemberPath="Account"
                                                    SortDirection="Ascending"
                                                    MinWidth="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Account}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Account}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="KEY"
                                                    CanUserSort="False"
                                                    Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding ApiKeyDisplay}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding ApiKeyToolTip}" />
                                            <setting:SettingButton Grid.Column="1"
                                                                   Content="⧉"
                                                                   Tag="{Binding}"
                                                                   IsEnabled="{Binding HasApiKey}"
                                                                   Click="CopyKeyButton_Click"
                                                                   ToolTip="Copy this profile's API key to the clipboard"
                                                                   ToolTipService.ShowOnDisabled="True"
                                                                   AutomationProperties.Name="Copy the API key" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="User ID"
                                                Binding="{Binding UserIdDisplay}"
                                                SortMemberPath="UserIdSort"
                                                Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="Balance"
                                                    CanUserSort="True"
                                                    SortMemberPath="BalanceSort"
                                                    Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding BalanceDisplay}"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Center"
                                                   ToolTip="{Binding BalanceToolTip}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Check balance"
                                                    CanUserSort="False"
                                                    Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <setting:SettingButton Content="Check balance"
                                                               Tag="{Binding}"
                                                               IsEnabled="{Binding HasLoginCredentials}"
                                                               Click="CheckBalanceButton_Click"
                                                               ToolTip="Read this account's balance from the gateway and store it in the profile JSON"
                                                               AutomationProperties.Name="Check the account balance" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Check login"
                                                    CanUserSort="False"
                                                    Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <setting:SettingButton Content="Check login"
                                                               Tag="{Binding}"
                                                               IsEnabled="{Binding HasLoginCredentials}"
                                                               Click="CheckLoginButton_Click"
                                                               ToolTip="Read today's sign-in log and save it to the profile JSON"
                                                               ToolTipService.ShowOnDisabled="True"
                                                               AutomationProperties.Name="Check daily login" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Login"
                                                    CanUserSort="False"
                                                    Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding LoginDisplay}"
                                                   ToolTip="{Binding LoginToolTip}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="16"
                                                   TextAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Proxy"
                                                    CanUserSort="False"
                                                    Width="220">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                                <ComboBox ItemsSource="{Binding ProxyChoices}"
                                                  SelectedItem="{Binding SelectedProxy, Mode=TwoWay}"
                                                  SelectionChanged="ProxySelection_SelectionChanged"
                                                  ToolTip="{Binding SelectedProxy}"
                                                  Style="{DynamicResource SettingComboBoxStyle}"
                                                  AutomationProperties.Name="Proxy selection" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Claim"
                                                    CanUserSort="False"
                                                    Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <setting:SettingButton Content="Claim"
                                                               Tag="{Binding}"
                                                               Click="ClaimButton_Click"
                                                               AutomationProperties.Name="Claim the daily reward" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Inject"
                                                    CanUserSort="False"
                                                    Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <setting:SettingButton Content="Inject"
                                                               Tag="{Binding}"
                                                               IsEnabled="{Binding HasApiKey}"
                                                               Click="InjectButton_Click"
                                                               ToolTip="Write this row's API key to Claude settings"
                                                               ToolTipService.ShowOnDisabled="True"
                                                               AutomationProperties.Name="Inject this profile into Claude settings" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Action"
                                                    CanUserSort="False"
                                                    MinWidth="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <setting:SettingTableActions>
                                            <setting:SettingTableActions.PrimaryContent>
                                                <setting:SettingButton Content="Remove"
                                                                      Tag="{Binding}"
                                                                      Click="ActionButton_Click"
                                                                      AutomationProperties.Name="Remove this shortcut" />
                                            </setting:SettingTableActions.PrimaryContent>
                                        </setting:SettingTableActions>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </setting:SettingTable.InteractiveColumns>
                    </setting:SettingTable>

                    <TextBlock x:Name="EmptyText"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="16"
                               FontWeight="SemiBold"
                               IsHitTestVisible="False"
                               Text="No profiles added yet. Use Select profiles…"
                               Visibility="Collapsed" />
                </Grid>
            </Border>
        </Grid>
    </setting:SettingViewport>
</UserControl>
