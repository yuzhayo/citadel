<UserControl x:Class="Module.Agentrouter.Features.Proxy.ProxyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:setting="clr-namespace:Citadel.Setting.Components;assembly=Citadel.Setting"
             Background="{DynamicResource Bg}"
             Foreground="{DynamicResource Fg}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <!--
      Read-only mirror of the Proxy screen's committed pool. No Ban, Remove or
      health-refresh actions here: those write files this screen does not own.
    -->
    <setting:SettingViewport Mode="Contained">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <setting:SettingActionCard>
                <setting:SettingActionCard.Content>
                    <StackPanel>
                        <TextBlock x:Name="SummaryText"
                                   FontWeight="SemiBold"
                                   Text="Committed pool: 0 proxies" />
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="{DynamicResource Body}"
                                   TextWrapping="Wrap"
                                   Text="Read-only view of the pool committed by the Proxy screen. Health and origin come from that screen's sidecars; Agentrouter never writes them." />
                        <TextBlock x:Name="StatusText"
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource Body}"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </setting:SettingActionCard.Content>
                <setting:SettingActionCard.ActionContent>
                    <setting:SettingButton x:Name="ReloadButton"
                                           Content="Reload"
                                           Click="ReloadButton_Click"
                                           AutomationProperties.Name="Reload committed proxy pool" />
                </setting:SettingActionCard.ActionContent>
            </setting:SettingActionCard>

            <Border Grid.Row="1"
                    Padding="0"
                    Style="{DynamicResource SettingCardStyle}">
                <Grid>
                    <setting:SettingTable x:Name="PoolTable"
                                          setting:UiPreference.Key="agentrouter.proxy.table"
                                          CanUserSortColumns="True"
                                          AutomationProperties.Name="Committed proxy pool">
                        <setting:SettingTable.InteractiveColumns>
                            <DataGridTextColumn Header="Endpoint"
                                                Binding="{Binding EndpointText}"
                                                SortMemberPath="EndpointText"
                                                MinWidth="220"
                                                Width="*" />

                            <DataGridTextColumn Header="Scheme"
                                                Binding="{Binding Scheme}"
                                                SortMemberPath="Scheme"
                                                Width="100" />

                            <DataGridTextColumn Header="Host"
                                                Binding="{Binding Host}"
                                                SortMemberPath="Host"
                                                MinWidth="140"
                                                Width="Auto" />

                            <DataGridTextColumn Header="Port"
                                                Binding="{Binding Port}"
                                                SortMemberPath="Port"
                                                Width="90" />

                            <DataGridTextColumn Header="Health"
                                                Binding="{Binding Health}"
                                                SortMemberPath="HealthSort"
                                                Width="110" />

                            <DataGridTextColumn Header="Latency"
                                                Binding="{Binding Latency}"
                                                SortMemberPath="LatencySort"
                                                Width="100" />

                            <DataGridTextColumn Header="Checked"
                                                Binding="{Binding Checked}"
                                                SortMemberPath="CheckedSort"
                                                Width="150" />

                            <DataGridTextColumn Header="Origin"
                                                Binding="{Binding Origin}"
                                                SortMemberPath="Origin"
                                                MinWidth="120"
                                                Width="Auto" />

                            <DataGridTextColumn Header="Diagnostic"
                                                Binding="{Binding Diagnostic}"
                                                SortMemberPath="Diagnostic"
                                                MinWidth="160"
                                                Width="Auto" />
                        </setting:SettingTable.InteractiveColumns>
                    </setting:SettingTable>

                    <TextBlock x:Name="EmptyText"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="16"
                               FontWeight="SemiBold"
                               IsHitTestVisible="False"
                               Text="No committed proxies."
                               Visibility="Collapsed" />
                </Grid>
            </Border>
        </Grid>
    </setting:SettingViewport>
</UserControl>
