<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The whole build for a screen: import Citizen.targets and declare nothing
    else about references, deployment or isolation — all of that comes from
    there.

    NOT in Citadel.slnx and must not be added: a screen is built directly
    (`dotnet build module/agentrouter/Module.Agentrouter.csproj`), which is what
    makes "add a screen without editing anything outside module/" true.
  -->
  <Import Project="..\..\core\Citizen.targets" />

  <!--
    Shared C# sources (PyHost client + RuntimeSetup + the proxy pool file
    contracts + CredenzPath), compiled into every citizen. These are mechanisms
    shared by all screens; Agentrouter's own policy stays in this folder.
  -->
  <ItemGroup>
    <Compile Include="..\sharedLogic\cs\**\*.cs" />
  </ItemGroup>

  <!--
    The claim flow ships as this citizen's pyhost plugin. The package folder
    name IS the importable name and plugin.py doubles as its __init__, which is
    exactly the convention Citizen.targets' DeployPyhostPlugins documents, so
    no extra build logic is needed here.
  -->
  <PropertyGroup>
    <PyhostPluginName>agentrouter_claim</PyhostPluginName>
  </PropertyGroup>

</Project>
