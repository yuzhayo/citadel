# Generated build and test output.
bin/
obj/
TestResults/
artifacts/
Releases/

# Editor and IDE local state.
.vs/
.idea/
*.user
*.suo

# Local agent tooling and configuration; the project UI contract skill, the
# modularity contract skill, and the boundary-enforcement hooks are versioned so
# every agent and every clone receives the same boundaries (gap 7, 2026-09-11).
!.agents/
.agents/*
!.agents/skills/
.agents/skills/*
!.agents/skills/citadel-shared-ui/
!.agents/skills/citadel-shared-ui/SKILL.md
!.agents/skills/citadel-feature-modularity/
!.agents/skills/citadel-feature-modularity/SKILL.md
!.agents/hooks/
!.agents/hooks/check-project-refs.mjs
!.agents/hooks/gate-on-stop.mjs
.claude/
.qoder/
.mcp.json
AGENTS.local.md

# Build-debug leftovers such as full_build.log, full_eval.xml, and csproj.bak.
*.log
*.bak
*_eval.xml

# Runtime log, if Log is ever pointed at the repo instead of %AppData%.
log.txt

# Credenz vault — credentials, profiles, sessions, results. Excluded one
# level at a time: excluding a directory itself would make the negations
# below unreachable (git never descends into an excluded directory), so each
# committed marker needs its parent dirs negated explicitly.
module/credenz/*
!module/credenz/README.md
!module/credenz/google
module/credenz/google/*
!module/credenz/google/profiles
module/credenz/google/profiles/*
!module/credenz/google/profiles/.gitkeep

# Python runtime state and bytecode. The venv and vendored interpreter live
# at %LocalAppData%\Citadel\runtime; these guards also catch accidents
# anywhere else in the tree.
.venv/
venv/
__pycache__/
*.pyc
*.pyo
