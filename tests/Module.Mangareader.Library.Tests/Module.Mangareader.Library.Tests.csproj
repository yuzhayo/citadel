<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <!--
    The MangaReader citizen is never a normal solution dependency: only the
    two pure Library persistence sources are linked, exactly as the citizen
    compiles them. They carry no WPF or MangaTitle dependency.
  -->
  <ItemGroup>
    <Compile Include="..\..\module\mangareader\Library\LibraryPathStore.cs"
             Link="Library\LibraryPathStore.cs" />
    <Compile Include="..\..\module\mangareader\Library\LibraryScanPersistence.cs"
             Link="Library\LibraryScanPersistence.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
