<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\setting\Citadel.Setting.csproj" />
  </ItemGroup>

  <!--
    The MangaReader citizen remains outside the solution dependency graph.
    Reader policies/engine sources are linked exactly as compiled by the
    citizen, while the CBZ decoder is replaced through IReaderChapterLoader.
  -->
  <ItemGroup>

    <None Include="..\..\module\mangareader\Features\Rar\Rar.exe"
          Link="Features\Rar\Rar.exe"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\module\mangareader\Features\Rar\rarreg.key"
          Link="Features\Rar\rarreg.key"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\module\sharedLogic\cs\ProxyPoolContract.cs" />
    <Compile Include="..\..\module\sharedLogic\cs\PyHost.cs" />
    <Compile Include="..\..\module\mangareader\Reader\**\*.cs" Link="Reader\%(RecursiveDir)%(Filename)%(Extension)" />
    <Page Include="..\..\module\mangareader\Reader\**\*.xaml" Link="Reader\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\module\mangareader\shareLogic\**\*.cs" Link="shareLogic\%(RecursiveDir)%(Filename)%(Extension)" />
    <Page Include="..\..\module\mangareader\shareLogic\**\*.xaml" Link="shareLogic\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
