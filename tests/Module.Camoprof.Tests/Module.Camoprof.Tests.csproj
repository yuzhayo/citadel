<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <!--
    The CamoProf citizen remains outside the solution dependency graph
    (Citizen.targets contract). Add Profile contract/coordinator/feature
    sources are linked exactly as compiled by the citizen, alongside the
    coordinator, the credential store, and the shared pyhost client
    sources they reference — same-assembly internals, no
    InternalsVisibleTo. Tests drive the coordinator through its delegate
    seams: no browser, no pyhost process, no real DPAPI writes. The
    dialog is deliberately NOT linked here: its post-close guard and
    cancellation ownership are code-reviewed only — a WPF harness was
    judged not worth the flake risk for one dialog; live smoke covers
    the real behavior and is tracked in tasks/todo.md.
  -->
  <ItemGroup>
    <Compile Include="..\..\module\sharedLogic\cs\**\*.cs" />
    <Compile Include="..\..\module\camoprof\sharedLogic\BrowserSessionCoordinator.cs" />
    <Compile Include="..\..\module\camoprof\Providers\Google\GoogleAccountRecord.cs" />
    <Compile Include="..\..\module\camoprof\Providers\Google\GoogleCredentialStore.cs" />
    <Compile Include="..\..\module\camoprof\Features\AddProfile\AddProfileContract.cs" />
    <Compile Include="..\..\module\camoprof\Features\AddProfile\AddProfileCoordinator.cs" />
    <Compile Include="..\..\module\camoprof\Features\AddProfile\AddProfileFeature.cs" />
    <Compile Include="..\..\module\camoprof\Features\AddProfile\AddProfilePyHostClient.cs" />
  </ItemGroup>

</Project>
